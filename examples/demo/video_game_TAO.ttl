    dcterms:identifier "Ind_ESRB" ;
    vg:op_appliesInJurisdiction vg:Ind_UnitedStates ;
    vg:ap_planScopeNote "The manager TIP assigns United States jurisdiction to ESRB and preserves the voluntary-rating scope note."@en ;
    dcterms:source vg:Ind_ManagerTIPDocument .

