    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ROMCartridge a owl:Class ;
    rdfs:label "ROM Cartridge"@en ;
    dcterms:identifier "Cl_ROMCartridge" ;
    rdfs:comment "A read-only-memory cartridge used to distribute a game."@en ;
    rdfs:subClassOf vg:Cl_GameMedia ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_MagneticStorage a owl:Class ;
    rdfs:label "Magnetic Storage"@en ;
    dcterms:identifier "Cl_MagneticStorage" ;
    rdfs:comment "Magnetic storage media used to distribute games."@en ;
    rdfs:subClassOf vg:Cl_GameMedia ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_MagneticTape a owl:Class ;
    rdfs:label "Magnetic Tape"@en ;
    dcterms:identifier "Cl_MagneticTape" ;
    rdfs:comment "Magnetic-tape media used to distribute a game."@en ;
    rdfs:subClassOf vg:Cl_MagneticStorage ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_FloppyDisc a owl:Class ;
    rdfs:label "Floppy Disc"@en ;
    dcterms:identifier "Cl_FloppyDisc" ;
    rdfs:comment "A floppy-disc medium used to distribute a game."@en ;
    rdfs:subClassOf vg:Cl_MagneticStorage ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_OpticalMedia a owl:Class ;
    rdfs:label "Optical Media"@en ;
    dcterms:identifier "Cl_OpticalMedia" ;
    rdfs:comment "Optical media used to distribute games."@en ;
    rdfs:subClassOf vg:Cl_GameMedia ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_CDROM a owl:Class ;
    rdfs:label "CD-ROM"@en ;
    dcterms:identifier "Cl_CDROM" ;
    rdfs:comment "A CD-ROM used to distribute a game."@en ;
    rdfs:subClassOf vg:Cl_OpticalMedia ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_DVD a owl:Class ;
    rdfs:label "DVD"@en ;
    dcterms:identifier "Cl_DVD" ;
    rdfs:comment "A DVD used to distribute a game."@en ;
    rdfs:subClassOf vg:Cl_OpticalMedia ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_FlashMemoryCard a owl:Class ;
    rdfs:label "Flash Memory Card"@en ;
    dcterms:identifier "Cl_FlashMemoryCard" ;
    rdfs:comment "A flash-memory card used to distribute a game."@en ;
    rdfs:subClassOf vg:Cl_GameMedia ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_DigitalDistributionPackage a owl:Class ;
    rdfs:label "Digital Distribution Package"@en ;
    dcterms:identifier "Cl_DigitalDistributionPackage" ;
    rdfs:comment "A digitally distributed package that carries a game or extension."@en ;
    rdfs:subClassOf vg:Cl_GameMedia ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ContentExtension a owl:Class ;
    rdfs:label "Content Extension"@en ;
    dcterms:identifier "Cl_ContentExtension" ;
    rdfs:comment "An extension released after a game's initial release to provide new content or software patches."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ExtensionReleaseSituation a owl:Class ;
    rdfs:label "Extension Release Situation"@en ;
    dcterms:identifier "Cl_ExtensionReleaseSituation" ;
    rdfs:comment "A reified situation that binds one content extension, the game or version it extends, that entity's initial release event, and the extension's own release event."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    owl:hasKey ( vg:op_releaseSituationExtension ) ;
    vg:ap_cqDerived true ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ExpansionPack a owl:Class ;
    rdfs:label "Expansion Pack"@en ;
    dcterms:identifier "Cl_ExpansionPack" ;
    rdfs:comment "A content extension commonly distributed as a separate package or physical medium."@en ;
    rdfs:subClassOf vg:Cl_ContentExtension ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_DownloadableContent a owl:Class ;
    rdfs:label "Downloadable Content"@en ;
    dcterms:identifier "Cl_DownloadableContent" ;
    rdfs:comment "A content extension nominally delivered by digital distribution."@en ;
    rdfs:subClassOf vg:Cl_ContentExtension ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_NewContent a owl:Class ;
    rdfs:label "New Content"@en ;
    dcterms:identifier "Cl_NewContent" ;
    rdfs:comment "New playable or supporting content provided by an extension."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_SoftwarePatch a owl:Class ;
    rdfs:label "Software Patch"@en ;
    dcterms:identifier "Cl_SoftwarePatch" ;
    rdfs:comment "A software update supplied for a game or version."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_UserGeneratedContent a owl:Class ;
    rdfs:label "User Generated Content"@en ;
    dcterms:identifier "Cl_UserGeneratedContent" ;
    rdfs:comment "Content created by players and shared for others to use."@en ;
    rdfs:subClassOf vg:Cl_NewContent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GameModification a owl:Class ;
    rdfs:label "Game Modification"@en ;
    dcterms:identifier "Cl_GameModification" ;
    rdfs:comment "A user-created or supported modification that alters or adds to a game."@en ;
    skos:altLabel "mod"@en ;
    rdfs:subClassOf vg:Cl_ContentExtension ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ClassificationAssignment a owl:Class ;
    rdfs:label "Classification Assignment"@en ;
    dcterms:identifier "Cl_ClassificationAssignment" ;
    rdfs:comment "A reified assignment linking one game, one classification value, and one classification criterion."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ClassificationCriterion a owl:Class ;
    rdfs:label "Classification Criterion"@en ;
    dcterms:identifier "Cl_ClassificationCriterion" ;
    rdfs:comment "A criterion used as the basis for assigning a game classification."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GameplayInteractionCriterion a owl:Class ;
    rdfs:label "Gameplay Interaction Criterion"@en ;
    dcterms:identifier "Cl_GameplayInteractionCriterion" ;
    rdfs:comment "The criterion that classifies genre primarily by gameplay interaction."@en ;
    rdfs:subClassOf vg:Cl_ClassificationCriterion ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_PlayerCountCriterion a owl:Class ;
    rdfs:label "Player Count Criterion"@en ;
    dcterms:identifier "Cl_PlayerCountCriterion" ;
    rdfs:comment "A criterion that classifies game mode by the number or arrangement of players."@en ;
    rdfs:subClassOf vg:Cl_ClassificationCriterion ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GamePurposeCriterion a owl:Class ;
    rdfs:label "Game Purpose Criterion"@en ;
    dcterms:identifier "Cl_GamePurposeCriterion" ;
    rdfs:comment "A criterion that classifies a game by entertainment or non-entertainment purpose."@en ;
    rdfs:subClassOf vg:Cl_ClassificationCriterion ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GameClassification a owl:Class ;
    rdfs:label "Game Classification"@en ;
    dcterms:identifier "Cl_GameClassification" ;
    rdfs:comment "A controlled value used to classify a video game."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    rdfs:subClassOf skos:Concept ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GameGenre a owl:Class ;
    rdfs:label "Game Genre"@en ;
    dcterms:identifier "Cl_GameGenre" ;
    rdfs:comment "A classification value describing a game's gameplay genre."@en ;
    rdfs:subClassOf vg:Cl_GameClassification ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GameMode a owl:Class ;
    rdfs:label "Game Mode"@en ;
    dcterms:identifier "Cl_GameMode" ;
    rdfs:comment "A classification value describing how many players can use a game."@en ;
    rdfs:subClassOf vg:Cl_GameClassification ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GameType a owl:Class ;
    rdfs:label "Game Type"@en ;
    dcterms:identifier "Cl_GameType" ;
    rdfs:comment "A classification value describing a game's purpose or broad type."@en ;
    rdfs:subClassOf vg:Cl_GameClassification ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ShooterGame a owl:Class ;
    rdfs:label "Shooter Game"@en ;
    dcterms:identifier "Cl_ShooterGame" ;
    rdfs:comment "A video game classified in the shooter genre."@en ;
    rdfs:subClassOf vg:Cl_VideoGame ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_FirstPersonShooter a owl:Class ;
    rdfs:label "First Person Shooter"@en ;
    dcterms:identifier "Cl_FirstPersonShooter" ;
    rdfs:comment "A shooter game classified as a first-person shooter."@en ;
    rdfs:subClassOf vg:Cl_ShooterGame ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ThirdPersonShooter a owl:Class ;
    rdfs:label "Third Person Shooter"@en ;
    dcterms:identifier "Cl_ThirdPersonShooter" ;
    rdfs:comment "A shooter game classified as a third-person shooter."@en ;
    rdfs:subClassOf vg:Cl_ShooterGame ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_SinglePlayerVideoGame a owl:Class ;
    rdfs:label "Single Player Video Game"@en ;
    dcterms:identifier "Cl_SinglePlayerVideoGame" ;
    rdfs:comment "A video game supporting a single-player mode."@en ;
    rdfs:subClassOf vg:Cl_VideoGame ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_MultiplayerVideoGame a owl:Class ;
    rdfs:label "Multiplayer Video Game"@en ;
    dcterms:identifier "Cl_MultiplayerVideoGame" ;
    rdfs:comment "A video game supporting a multiplayer mode."@en ;
    rdfs:subClassOf vg:Cl_VideoGame ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_SeriousGame a owl:Class ;
    rdfs:label "Serious Game"@en ;
    dcterms:identifier "Cl_SeriousGame" ;
    rdfs:comment "A video game whose non-entertainment purpose may augment, overshadow, or replace entertainment."@en ;
    rdfs:subClassOf vg:Cl_VideoGame ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_EducationalGame a owl:Class ;
    rdfs:label "Educational Game"@en ;
    dcterms:identifier "Cl_EducationalGame" ;
    rdfs:comment "A serious game designed or adapted for education."@en ;
    rdfs:subClassOf vg:Cl_SeriousGame ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_NonEntertainmentPurpose a owl:Class ;
    rdfs:label "Non Entertainment Purpose"@en ;
    dcterms:identifier "Cl_NonEntertainmentPurpose" ;
    rdfs:comment "A purpose other than entertainment that a serious game is designed to reinforce."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ContentRatingOrganization a owl:Class ;
    rdfs:label "Content Rating Organization"@en ;
    dcterms:identifier "Cl_ContentRatingOrganization" ;
    rdfs:comment "A national or regional organization that assigns content ratings within a jurisdiction."@en ;
    rdfs:subClassOf vg:Cl_Organization ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ContentRatingAssignment a owl:Class ;
    rdfs:label "Content Rating Assignment"@en ;
    dcterms:identifier "Cl_ContentRatingAssignment" ;
    rdfs:comment "A reified decision linking a rated game or version, a rating authority, a rating, and a jurisdiction."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ContentRating a owl:Class ;
    rdfs:label "Content Rating"@en ;
    dcterms:identifier "Cl_ContentRating" ;
    rdfs:comment "A controlled content-rating value."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    rdfs:subClassOf skos:Concept ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ESRB a owl:Class ;
    rdfs:label "ESRB"@en ;
    dcterms:identifier "Cl_ESRB" ;
    rdfs:comment "A compatibility class for the Entertainment Software Rating Board."@en ;
    rdfs:subClassOf vg:Cl_ContentRatingOrganization ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_PEGI a owl:Class ;
    rdfs:label "PEGI"@en ;
    dcterms:identifier "Cl_PEGI" ;
    rdfs:comment "A compatibility class for Pan European Game Information."@en ;
    rdfs:subClassOf vg:Cl_ContentRatingOrganization ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_CERO a owl:Class ;
    rdfs:label "CERO"@en ;
    dcterms:identifier "Cl_CERO" ;
    rdfs:comment "A compatibility class for the Computer Entertainment Rating Organization."@en ;
    rdfs:subClassOf vg:Cl_ContentRatingOrganization ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_RatingCoalition a owl:Class ;
    rdfs:label "Rating Coalition"@en ;
    dcterms:identifier "Cl_RatingCoalition" ;
    rdfs:comment "A coalition that aligns or streamlines regional content-rating systems."@en ;
    rdfs:subClassOf vg:Cl_Organization ;
    dcterms:source vg:Ind_ManagerTIPDocument .

# Object-property declarations

vg:op_hasParticipation a owl:ObjectProperty ;
    rdfs:label "has Participation"@en ;
    dcterms:identifier "op_hasParticipation" ;
    rdfs:comment "Links an event to a reified participation in that event."@en ;
    rdfs:domain vg:Cl_Event ;
    rdfs:range vg:Cl_Participation ;
    owl:inverseOf vg:op_participatesIn ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_participant a owl:ObjectProperty ;
    rdfs:label "participant"@en ;
    dcterms:identifier "op_participant" ;
    rdfs:comment "Identifies the entity bearing the role in a participation."@en ;
    rdfs:domain vg:Cl_Participation ;
    rdfs:range vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_participatesIn a owl:ObjectProperty ;
    rdfs:label "participates In"@en ;
    dcterms:identifier "op_participatesIn" ;
    rdfs:comment "Identifies the event in which a participation occurs."@en ;
    rdfs:domain vg:Cl_Participation ;
    rdfs:range vg:Cl_Event ;
    owl:inverseOf vg:op_hasParticipation ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_playsRole a owl:ObjectProperty ;
    rdfs:label "plays Role"@en ;
    dcterms:identifier "op_playsRole" ;
    rdfs:comment "Identifies the contextual role borne in a participation."@en ;
    rdfs:domain vg:Cl_Participation ;
    rdfs:range vg:Cl_ParticipantRole ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_actsThroughAvatarParticipation a owl:ObjectProperty ;
    rdfs:label "acts Through Avatar Participation"@en ;
    dcterms:identifier "op_actsThroughAvatarParticipation" ;
    rdfs:comment "Links a player participation to the corresponding avatar participation."@en ;
    rdfs:domain vg:Cl_Participation ;
    rdfs:range vg:Cl_Participation ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasInteractionEvent a owl:ObjectProperty ;
    rdfs:label "has Interaction Event"@en ;
    dcterms:identifier "op_hasInteractionEvent" ;
    rdfs:comment "Links a video game to a player-interaction event."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_PlayerInteractionEvent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_usesInputDevice a owl:ObjectProperty ;
    rdfs:label "uses Input Device"@en ;
    dcterms:identifier "op_usesInputDevice" ;
    rdfs:comment "Links a video game to an input device used for interaction."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_InputDevice ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_generatesVisualFeedback a owl:ObjectProperty ;
    rdfs:label "generates Visual Feedback"@en ;
    dcterms:identifier "op_generatesVisualFeedback" ;
    rdfs:comment "Links a video game to visual feedback it generates."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_VisualFeedback ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasFunction a owl:ObjectProperty ;
    rdfs:label "has Function"@en ;
    dcterms:identifier "op_hasFunction" ;
    rdfs:comment "Links a device to a reified device function."@en ;
    rdfs:domain vg:Cl_Device ;
    rdfs:range vg:Cl_DeviceFunction ;
    owl:inverseOf vg:op_functionOf ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_translatesAction a owl:ObjectProperty ;
    rdfs:label "translates Action"@en ;
    dcterms:identifier "op_translatesAction" ;
    rdfs:comment "Links an input device to a human action it translates."@en ;
    rdfs:domain vg:Cl_InputDevice ;
    rdfs:range vg:Cl_HumanAction ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_producesGameInput a owl:ObjectProperty ;
    rdfs:label "produces Game Input"@en ;
    dcterms:identifier "op_producesGameInput" ;
    rdfs:comment "Links an input device to game input it produces."@en ;
    rdfs:domain vg:Cl_InputDevice ;
    rdfs:range vg:Cl_GameInput ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_usedInInteraction a owl:ObjectProperty ;
    rdfs:label "used In Interaction"@en ;
    dcterms:identifier "op_usedInInteraction" ;
    rdfs:comment "Links an input device to an interaction event in which it is used."@en ;
    rdfs:domain vg:Cl_InputDevice ;
    rdfs:range vg:Cl_PlayerInteractionEvent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_presentsVisualFeedback a owl:ObjectProperty ;
    rdfs:label "presents Visual Feedback"@en ;
    dcterms:identifier "op_presentsVisualFeedback" ;
    rdfs:comment "Links a display device to visual feedback it presents."@en ;
    rdfs:domain vg:Cl_DisplayDevice ;
    rdfs:range vg:Cl_VisualFeedback ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_realizesVisualDisplay a owl:ObjectProperty ;
    rdfs:label "realizes Visual Display"@en ;
    dcterms:identifier "op_realizesVisualDisplay" ;
    rdfs:comment "Links a display device to the visual display it realizes."@en ;
    rdfs:domain vg:Cl_DisplayDevice ;
    rdfs:range vg:Cl_VisualDisplay ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_affectsVisualDisplay a owl:ObjectProperty ;
    rdfs:label "affects Visual Display"@en ;
    dcterms:identifier "op_affectsVisualDisplay" ;
    rdfs:comment "Links player interaction to the visual display it affects."@en ;
    rdfs:domain vg:Cl_PlayerInteractionEvent ;
    rdfs:range vg:Cl_VisualDisplay ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_functionOf a owl:ObjectProperty ;
    rdfs:label "function Of"@en ;
    dcterms:identifier "op_functionOf" ;
    rdfs:comment "Identifies the device that bears a reified function."@en ;
    rdfs:domain vg:Cl_DeviceFunction ;
    rdfs:range vg:Cl_Device ;
    owl:inverseOf vg:op_hasFunction ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:op_functionTranslatesAction a owl:ObjectProperty ;
    rdfs:label "function Translates Action"@en ;
    dcterms:identifier "op_functionTranslatesAction" ;
    rdfs:comment "Identifies an action translated by an input-translation function."@en ;
    rdfs:domain vg:Cl_InputTranslationFunction ;
    rdfs:range vg:Cl_HumanAction ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:op_functionProducesGameInput a owl:ObjectProperty ;
    rdfs:label "function Produces Game Input"@en ;
    dcterms:identifier "op_functionProducesGameInput" ;
    rdfs:comment "Identifies game input produced by an input-translation function."@en ;
    rdfs:domain vg:Cl_InputTranslationFunction ;
    rdfs:range vg:Cl_GameInput ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:op_functionPresentsVisualFeedback a owl:ObjectProperty ;
    rdfs:label "function Presents Visual Feedback"@en ;
    dcterms:identifier "op_functionPresentsVisualFeedback" ;
    rdfs:comment "Identifies visual feedback presented by a visual-presentation function."@en ;
    rdfs:domain vg:Cl_VisualPresentationFunction ;
    rdfs:range vg:Cl_VisualFeedback ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:op_functionRealizesVisualDisplay a owl:ObjectProperty ;
    rdfs:label "function Realizes Visual Display"@en ;
    dcterms:identifier "op_functionRealizesVisualDisplay" ;
    rdfs:comment "Identifies the visual display realized by a visual-presentation function."@en ;
    rdfs:domain vg:Cl_VisualPresentationFunction ;
    rdfs:range vg:Cl_VisualDisplay ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:op_usesUserInterface a owl:ObjectProperty ;
    rdfs:label "uses User Interface"@en ;
    dcterms:identifier "op_usesUserInterface" ;
    rdfs:comment "Links a video game to a user interface used in interaction."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_UserInterface ;
    dcterms:source vg:Ind_VideoGameDescriptionDocument .

vg:op_usesInteractionInterface a owl:ObjectProperty ;
    rdfs:label "uses Interaction Interface"@en ;
    dcterms:identifier "op_usesInteractionInterface" ;
    rdfs:comment "Links a video game to a user interface or input device used for interaction."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range [ a owl:Class ; owl:unionOf ( vg:Cl_UserInterface vg:Cl_InputDevice ) ] ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:op_usesDisplayDevice a owl:ObjectProperty ;
    rdfs:label "uses Display Device"@en ;
    dcterms:identifier "op_usesDisplayDevice" ;
    rdfs:comment "Links a video game to a device that presents its visual feedback."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_DisplayDevice ;
    dcterms:source vg:Ind_VideoGameDescriptionDocument .

vg:op_generatesAudioFeedback a owl:ObjectProperty ;
    rdfs:label "generates Audio Feedback"@en ;
    dcterms:identifier "op_generatesAudioFeedback" ;
    rdfs:comment "Links a video game to audio feedback it generates."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_AudioFeedback ;
    dcterms:source vg:Ind_VideoGameDescriptionDocument .

vg:op_generatesHapticFeedback a owl:ObjectProperty ;
    rdfs:label "generates Haptic Feedback"@en ;
    dcterms:identifier "op_generatesHapticFeedback" ;
    rdfs:comment "Links a video game to haptic feedback it generates."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_HapticFeedback ;
    dcterms:source vg:Ind_VideoGameDescriptionDocument .

vg:op_presentsAudioFeedback a owl:ObjectProperty ;
    rdfs:label "presents Audio Feedback"@en ;
    dcterms:identifier "op_presentsAudioFeedback" ;
    rdfs:comment "Links an audio-output device to audio feedback it presents."@en ;
    rdfs:domain vg:Cl_AudioOutputDevice ;
    rdfs:range vg:Cl_AudioFeedback ;
    dcterms:source vg:Ind_VideoGameDescriptionDocument .

vg:op_realizesHapticFeedback a owl:ObjectProperty ;
    rdfs:label "realizes Haptic Feedback"@en ;
    dcterms:identifier "op_realizesHapticFeedback" ;
    rdfs:comment "Links a controller to haptic feedback it realizes."@en ;
    rdfs:domain vg:Cl_GameController ;
    rdfs:range vg:Cl_HapticFeedback ;
    dcterms:source vg:Ind_VideoGameDescriptionDocument .

vg:op_simulatesGameplayEvent a owl:ObjectProperty ;
    rdfs:label "simulates Gameplay Event"@en ;
    dcterms:identifier "op_simulatesGameplayEvent" ;
    rdfs:comment "Links haptic feedback to an in-game event it simulates."@en ;
    rdfs:domain vg:Cl_HapticFeedback ;
    rdfs:range vg:Cl_GameplayEvent ;
    dcterms:source vg:Ind_VideoGameDescriptionDocument .

vg:op_occursInGame a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "occurs In Game"@en ;
    dcterms:identifier "op_occursInGame" ;
    rdfs:comment "Identifies the unique game context of a gameplay event."@en ;
    rdfs:domain vg:Cl_GameplayEvent ;
    rdfs:range vg:Cl_VideoGame ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_sessionOfGame a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "session Of Game"@en ;
    dcterms:identifier "op_sessionOfGame" ;
    rdfs:comment "Identifies the unique video game to which a gameplay session belongs."@en ;
    rdfs:domain vg:Cl_GameplaySession ;
    rdfs:range vg:Cl_VideoGame ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_containsEvent a owl:ObjectProperty ;
    rdfs:label "contains Event"@en ;
    dcterms:identifier "op_containsEvent" ;
    rdfs:comment "Links a gameplay session to an instantaneous event grouped within it."@en ;
    rdfs:domain vg:Cl_GameplaySession ;
    rdfs:range vg:Cl_InstantaneousEvent ;
    owl:inverseOf vg:op_occursInSession ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_occursInSession a owl:ObjectProperty ;
    rdfs:label "occurs In Session"@en ;
    dcterms:identifier "op_occursInSession" ;
    rdfs:comment "Identifies the gameplay session containing an instantaneous event."@en ;
    rdfs:domain vg:Cl_InstantaneousEvent ;
    rdfs:range vg:Cl_GameplaySession ;
    owl:inverseOf vg:op_containsEvent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasTemporalExtent a owl:ObjectProperty ;
    rdfs:label "has Temporal Extent"@en ;
    dcterms:identifier "op_hasTemporalExtent" ;
    rdfs:comment "Links an event to its temporal extent."@en ;
    rdfs:domain vg:Cl_Event ;
    rdfs:range time:TemporalEntity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_triggeredBy a owl:ObjectProperty ;
    rdfs:label "triggered By"@en ;
    dcterms:identifier "op_triggeredBy" ;
    rdfs:comment "Links a gameplay event to an explicit trigger condition."@en ;
    rdfs:domain vg:Cl_GameplayEvent ;
    rdfs:range vg:Cl_GameplayCondition ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasOutcome a owl:ObjectProperty ;
    rdfs:label "has Outcome"@en ;
    dcterms:identifier "op_hasOutcome" ;
    rdfs:comment "Links a gameplay event to an outcome."@en ;
    rdfs:domain vg:Cl_GameplayEvent ;
    rdfs:range vg:Cl_GameplayOutcome ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_involvesItem a owl:ObjectProperty ;
    rdfs:label "involves Item"@en ;
    dcterms:identifier "op_involvesItem" ;
    rdfs:comment "Links a gameplay event to an item involved in it."@en ;
    rdfs:domain vg:Cl_GameplayEvent ;
    rdfs:range vg:Cl_Item ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_affectedCharacter a owl:ObjectProperty ;
    rdfs:label "affected Character"@en ;
    dcterms:identifier "op_affectedCharacter" ;
    rdfs:comment "Links a gameplay event to a character it affects."@en ;
    rdfs:domain vg:Cl_GameplayEvent ;
    rdfs:range vg:Cl_Character ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasAttributeState a owl:ObjectProperty ;
    rdfs:label "has Attribute State"@en ;
    dcterms:identifier "op_hasAttributeState" ;
    rdfs:comment "Links an avatar to a temporalized attribute state."@en ;
    rdfs:domain vg:Cl_Avatar ;
    rdfs:range vg:Cl_AttributeState ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_stateOf a owl:ObjectProperty ;
    rdfs:label "state Of"@en ;
    dcterms:identifier "op_stateOf" ;
    rdfs:comment "Identifies the entity whose state is represented."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( vg:Cl_AttributeState vg:Cl_LifeCountState ) ] ;
    rdfs:range vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_forAttribute a owl:ObjectProperty ;
    rdfs:label "for Attribute"@en ;
    dcterms:identifier "op_forAttribute" ;
    rdfs:comment "Identifies the attribute represented by an attribute-state node."@en ;
    rdfs:domain vg:Cl_AttributeState ;
    rdfs:range vg:Cl_Attribute ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasStateBefore a owl:ObjectProperty ;
    rdfs:label "has State Before"@en ;
    dcterms:identifier "op_hasStateBefore" ;
    rdfs:comment "Links an event to a state holding before it."@en ;
    rdfs:domain vg:Cl_GameplayEvent ;
    rdfs:range [ a owl:Class ; owl:unionOf ( vg:Cl_AttributeState vg:Cl_LifeCountState ) ] ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasStateAfter a owl:ObjectProperty ;
    rdfs:label "has State After"@en ;
    dcterms:identifier "op_hasStateAfter" ;
    rdfs:comment "Links an event to a state holding after it."@en ;
    rdfs:domain vg:Cl_GameplayEvent ;
    rdfs:range [ a owl:Class ; owl:unionOf ( vg:Cl_AttributeState vg:Cl_LifeCountState ) ] ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_evidencedByState a owl:ObjectProperty ;
    rdfs:label "evidenced By State"@en ;
    dcterms:identifier "op_evidencedByState" ;
    rdfs:comment "Links a condition to a state that explicitly evidences it."@en ;
    rdfs:domain vg:Cl_GameplayCondition ;
    rdfs:range [ a owl:Class ; owl:unionOf ( vg:Cl_AttributeState vg:Cl_LifeCountState ) ] ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_atLocation a owl:ObjectProperty ;
    rdfs:label "at Location"@en ;
    dcterms:identifier "op_atLocation" ;
    rdfs:comment "Identifies the inescapable location involved in an entrapment condition."@en ;
    rdfs:domain vg:Cl_EntrapmentCondition ;
    rdfs:range vg:Cl_InescapableLocation ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_canPreventCondition a owl:ObjectProperty ;
    rdfs:label "can Prevent Condition"@en ;
    dcterms:identifier "op_canPreventCondition" ;
    rdfs:comment "Links an item to a condition it can prevent, such as an extra life preventing all lives being lost."@en ;
    rdfs:domain vg:Cl_Item ;
    rdfs:range vg:Cl_GameplayCondition ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_requiresPlatform a owl:ObjectProperty ;
    rdfs:label "requires Platform"@en ;
    dcterms:identifier "op_requiresPlatform" ;
    rdfs:comment "Links a video game to a platform required for operation."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_Platform ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_designedForPlatform a owl:ObjectProperty ;
    rdfs:label "designed For Platform"@en ;
    dcterms:identifier "op_designedForPlatform" ;
    rdfs:comment "Links a video game to a platform for which it was designed."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_Platform ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasHardwareComponent a owl:ObjectProperty ;
    rdfs:label "has Hardware Component"@en ;
    dcterms:identifier "op_hasHardwareComponent" ;
    rdfs:comment "Links a platform to a hardware component."@en ;
    rdfs:domain vg:Cl_Platform ;
    rdfs:range vg:Cl_HardwareComponent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasSoftwareComponent a owl:ObjectProperty ;
    rdfs:label "has Software Component"@en ;
    dcterms:identifier "op_hasSoftwareComponent" ;
    rdfs:comment "Links a platform to a software component."@en ;
    rdfs:domain vg:Cl_Platform ;
    rdfs:range vg:Cl_SoftwareComponent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_usesOperatingSystem a owl:ObjectProperty ;
    rdfs:label "uses Operating System"@en ;
    dcterms:identifier "op_usesOperatingSystem" ;
    rdfs:comment "Links a platform to an operating system it uses."@en ;
    rdfs:domain vg:Cl_Platform ;
    rdfs:range vg:Cl_OperatingSystem ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasCloudProcessingActivity a owl:ObjectProperty ;
    rdfs:label "has Cloud Processing Activity"@en ;
    dcterms:identifier "op_hasCloudProcessingActivity" ;
    rdfs:comment "Links a cloud game to the activity that computes or renders it."@en ;
    rdfs:domain vg:Cl_CloudGame ;
    rdfs:range vg:Cl_CloudProcessingActivity ;
    owl:inverseOf vg:op_processingForCloudGame ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_computedOn a owl:ObjectProperty ;
    rdfs:label "computed On"@en ;
    dcterms:identifier "op_computedOn" ;
    rdfs:comment "Identifies remote hardware on which cloud processing occurs."@en ;
    rdfs:domain vg:Cl_CloudProcessingActivity ;
    rdfs:range vg:Cl_RemoteHardware ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_operatedBy a owl:ObjectProperty ;
    rdfs:label "operated By"@en ;
    dcterms:identifier "op_operatedBy" ;
    rdfs:comment "Identifies the provider operating cloud processing or remote hardware."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( vg:Cl_CloudProcessingActivity vg:Cl_RemoteHardware ) ] ;
    rdfs:range vg:Cl_CloudGamingProvider ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasDisplayComponent a owl:ObjectProperty ;
    rdfs:label "has Display Component"@en ;
    dcterms:identifier "op_hasDisplayComponent" ;
    rdfs:comment "Links a device to a stereoscopic-screen component."@en ;
    rdfs:domain vg:Cl_Device ;
    rdfs:range vg:Cl_StereoscopicScreen ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_supportsTechnology a owl:ObjectProperty ;
    rdfs:label "supports Technology"@en ;
    dcterms:identifier "op_supportsTechnology" ;
    rdfs:comment "Links a device to feedback or motion-tracking technology it supports."@en ;
    rdfs:domain vg:Cl_Device ;
    rdfs:range [ a owl:Class ; owl:unionOf ( vg:Cl_FeedbackTechnology vg:Cl_MotionTrackingTechnology ) ] ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasAudioOutputDevice a owl:ObjectProperty ;
    rdfs:label "has Audio Output Device"@en ;
    dcterms:identifier "op_hasAudioOutputDevice" ;
    rdfs:comment "Links a platform to an audio-output device."@en ;
    rdfs:domain vg:Cl_Platform ;
    rdfs:range vg:Cl_AudioOutputDevice ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_connectsToDisplay a owl:ObjectProperty ;
    rdfs:label "connects To Display"@en ;
    dcterms:identifier "op_connectsToDisplay" ;
    rdfs:comment "Links a platform to a display device to which it connects."@en ;
    rdfs:domain vg:Cl_Platform ;
    rdfs:range vg:Cl_DisplayDevice ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasVersion a owl:ObjectProperty ;
    rdfs:label "has Version"@en ;
    dcterms:identifier "op_hasVersion" ;
    rdfs:comment "Links a video game to one of its versions."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_GameVersion ;
    owl:inverseOf vg:op_versionOf ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_versionOf a owl:ObjectProperty ;
    rdfs:label "version Of"@en ;
    dcterms:identifier "op_versionOf" ;
    rdfs:comment "Identifies the video game of which an entity is a version."@en ;
    rdfs:domain vg:Cl_GameVersion ;
    rdfs:range vg:Cl_VideoGame ;
    owl:inverseOf vg:op_hasVersion ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived From"@en ;
    dcterms:identifier "op_derivedFrom" ;
    rdfs:comment "Links a game version to a source game or source version."@en ;
    rdfs:domain vg:Cl_GameVersion ;
    rdfs:range [ a owl:Class ; owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion ) ] ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_generatedByDevelopment a owl:ObjectProperty ;
    rdfs:label "generated By Development"@en ;
    dcterms:identifier "op_generatedByDevelopment" ;
    rdfs:comment "Links a game version to the development activity that generated it."@en ;
    rdfs:domain vg:Cl_GameVersion ;
    rdfs:range vg:Cl_DevelopmentActivity ;
    rdfs:subPropertyOf prov:wasGeneratedBy ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_targetPlatform a owl:ObjectProperty ;
    rdfs:label "target Platform"@en ;
    dcterms:identifier "op_targetPlatform" ;
    rdfs:comment "Identifies the platform targeted by a game version."@en ;
    rdfs:domain vg:Cl_GameVersion ;
    rdfs:range vg:Cl_Platform ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_reusesAsset a owl:ObjectProperty ;
    rdfs:label "reuses Asset"@en ;
    dcterms:identifier "op_reusesAsset" ;
    rdfs:comment "Links a remaster development activity to a reused game asset."@en ;
    rdfs:domain vg:Cl_RemasterDevelopmentActivity ;
    rdfs:range vg:Cl_GameAsset ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_distributedOnMedium a owl:ObjectProperty ;
    rdfs:label "distributed On Medium"@en ;
    dcterms:identifier "op_distributedOnMedium" ;
    rdfs:comment "Links a game, version, or extension to a distribution medium."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion vg:Cl_ContentExtension ) ] ;
    rdfs:range vg:Cl_GameMedia ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_readsMedium a owl:ObjectProperty ;
    rdfs:label "reads Medium"@en ;
    dcterms:identifier "op_readsMedium" ;
    rdfs:comment "Links a platform to a game medium it can read."@en ;
    rdfs:domain vg:Cl_Platform ;
    rdfs:range vg:Cl_GameMedia ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_extendsGame a owl:ObjectProperty ;
    rdfs:label "extends Game"@en ;
    dcterms:identifier "op_extendsGame" ;
    rdfs:comment "Shortcut identifying the game or version bound to a content extension by its extension-release situation."@en ;
    rdfs:domain vg:Cl_ContentExtension ;
    rdfs:range [ a owl:Class ; owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion ) ] ;
    owl:propertyChainAxiom ( vg:op_hasExtensionReleaseSituation vg:op_releaseSituationExtendedEntity ) ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasExtensionReleaseSituation a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has Extension Release Situation"@en ;
    dcterms:identifier "op_hasExtensionReleaseSituation" ;
    rdfs:comment "Links a content extension to the canonical situation that binds its target and release-order facts."@en ;
    rdfs:domain vg:Cl_ContentExtension ;
    rdfs:range vg:Cl_ExtensionReleaseSituation ;
    owl:inverseOf vg:op_releaseSituationExtension ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_releaseSituationExtension a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "release Situation Extension"@en ;
    dcterms:identifier "op_releaseSituationExtension" ;
    rdfs:comment "Identifies the unique content extension described by an extension-release situation."@en ;
    rdfs:domain vg:Cl_ExtensionReleaseSituation ;
    rdfs:range vg:Cl_ContentExtension ;
    owl:inverseOf vg:op_hasExtensionReleaseSituation ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_releaseSituationExtendedEntity a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "release Situation Extended Entity"@en ;
    dcterms:identifier "op_releaseSituationExtendedEntity" ;
    rdfs:comment "Identifies the unique game or version extended in an extension-release situation."@en ;
    rdfs:domain vg:Cl_ExtensionReleaseSituation ;
    rdfs:range [ a owl:Class ; owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion ) ] ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_releaseSituationInitialReleaseEvent a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "release Situation Initial Release Event"@en ;
    dcterms:identifier "op_releaseSituationInitialReleaseEvent" ;
    rdfs:comment "Identifies the initial release event of the extended game or version in an extension-release situation."@en ;
    rdfs:domain vg:Cl_ExtensionReleaseSituation ;
    rdfs:range vg:Cl_ReleaseEvent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_releaseSituationExtensionReleaseEvent a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "release Situation Extension Release Event"@en ;
    dcterms:identifier "op_releaseSituationExtensionReleaseEvent" ;
    rdfs:comment "Identifies the content extension's own release event in an extension-release situation."@en ;
    rdfs:domain vg:Cl_ExtensionReleaseSituation ;
    rdfs:range vg:Cl_ReleaseEvent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_providesContent a owl:ObjectProperty ;
    rdfs:label "provides Content"@en ;
    dcterms:identifier "op_providesContent" ;
    rdfs:comment "Links a content extension to new content it provides."@en ;
    rdfs:domain vg:Cl_ContentExtension ;
    rdfs:range vg:Cl_NewContent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_providesPatch a owl:ObjectProperty ;
    rdfs:label "provides Patch"@en ;
    dcterms:identifier "op_providesPatch" ;
    rdfs:comment "Links a content extension to a software patch it provides."@en ;
    rdfs:domain vg:Cl_ContentExtension ;
    rdfs:range vg:Cl_SoftwarePatch ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_sourcePlatform a owl:ObjectProperty ;
    rdfs:label "source Platform"@en ;
    dcterms:identifier "op_sourcePlatform" ;
    rdfs:comment "Identifies the source platform from which a version was adapted."@en ;
    rdfs:domain vg:Cl_GameVersion ;
    rdfs:range vg:Cl_Platform ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_updatesAsset a owl:ObjectProperty ;
    rdfs:label "updates Asset"@en ;
    dcterms:identifier "op_updatesAsset" ;
    rdfs:comment "Links remaster development to an asset updated for modern systems."@en ;
    rdfs:domain vg:Cl_RemasterDevelopmentActivity ;
    rdfs:range vg:Cl_GameAsset ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_reworksSource a owl:ObjectProperty ;
    rdfs:label "reworks Source"@en ;
    dcterms:identifier "op_reworksSource" ;
    rdfs:comment "Links remake development to the source game or version that is significantly reworked."@en ;
    rdfs:domain vg:Cl_RemakeDevelopmentActivity ;
    rdfs:range [ a owl:Class ; owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion ) ] ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasSourceGame a owl:ObjectProperty ;
    rdfs:label "has Source Game"@en ;
    dcterms:identifier "op_hasSourceGame" ;
    rdfs:comment "Shortcut linking development activity to its source game or version."@en ;
    rdfs:domain vg:Cl_DevelopmentActivity ;
    rdfs:range [ a owl:Class ; owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion ) ] ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasResultingVersion a owl:ObjectProperty ;
    rdfs:label "has Resulting Version"@en ;
    dcterms:identifier "op_hasResultingVersion" ;
    rdfs:comment "Shortcut linking development activity to its resulting version."@en ;
    rdfs:domain vg:Cl_DevelopmentActivity ;
    rdfs:range vg:Cl_GameVersion ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasReleaseEvent a owl:ObjectProperty ;
    rdfs:label "has Release Event"@en ;
    dcterms:identifier "op_hasReleaseEvent" ;
    rdfs:comment "Links a released entity to a release event; for content extensions the canonical value is derived from the extension-release situation."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion vg:Cl_ContentExtension ) ] ;
    rdfs:range vg:Cl_ReleaseEvent ;
    owl:inverseOf vg:op_releasedEntity ;
    owl:propertyChainAxiom ( vg:op_hasExtensionReleaseSituation vg:op_releaseSituationExtensionReleaseEvent ) ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasInitialReleaseEvent a owl:ObjectProperty ;
    rdfs:label "has Initial Release Event"@en ;
    dcterms:identifier "op_hasInitialReleaseEvent" ;
    rdfs:comment "Explicitly identifies the initial release event of a game or game version."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion ) ] ;
    rdfs:range vg:Cl_ReleaseEvent ;
    rdfs:subPropertyOf vg:op_hasReleaseEvent ;
    owl:propertyChainAxiom (
        [ owl:inverseOf vg:op_releaseSituationExtendedEntity ]
        vg:op_releaseSituationInitialReleaseEvent
    ) ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasDesignation a owl:ObjectProperty ;
    rdfs:label "has Designation"@en ;
    dcterms:identifier "op_hasDesignation" ;
    rdfs:comment "Links an entity to a sourced historical designation."@en ;
    rdfs:domain vg:Cl_Entity ;
    rdfs:range vg:Cl_HistoricalDesignation ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasIntroductionEvent a owl:ObjectProperty ;
    rdfs:label "has Introduction Event"@en ;
    dcterms:identifier "op_hasIntroductionEvent" ;
    rdfs:comment "Links a platform to its introduction event."@en ;
    rdfs:domain vg:Cl_Platform ;
    rdfs:range vg:Cl_IntroductionEvent ;
    owl:inverseOf vg:op_introducedPlatform ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasReleaseTime a owl:ObjectProperty ;
    rdfs:label "has Release Time"@en ;
    dcterms:identifier "op_hasReleaseTime" ;
    rdfs:comment "Links a release event to its release temporal entity."@en ;
    rdfs:domain vg:Cl_ReleaseEvent ;
    rdfs:range vg:Cl_ReleaseTemporalEntity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_inspiredBy a owl:ObjectProperty ;
    rdfs:label "inspired By"@en ;
    dcterms:identifier "op_inspiredBy" ;
    rdfs:comment "Links a game to an earlier game that inspired it."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_VideoGame ;
    rdfs:subPropertyOf prov:wasInfluencedBy ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasClassificationAssignment a owl:ObjectProperty ;
    rdfs:label "has Classification Assignment"@en ;
    dcterms:identifier "op_hasClassificationAssignment" ;
    rdfs:comment "Links a game to a reified classification assignment."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_ClassificationAssignment ;
    owl:inverseOf vg:op_classifiedGame ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_classifiedGame a owl:ObjectProperty ;
    rdfs:label "classified Game"@en ;
    dcterms:identifier "op_classifiedGame" ;
    rdfs:comment "Identifies the game classified by an assignment."@en ;
    rdfs:domain vg:Cl_ClassificationAssignment ;
    rdfs:range vg:Cl_VideoGame ;
    owl:inverseOf vg:op_hasClassificationAssignment ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_classificationValue a owl:ObjectProperty ;
    rdfs:label "classification Value"@en ;
    dcterms:identifier "op_classificationValue" ;
    rdfs:comment "Identifies the controlled classification value assigned."@en ;
    rdfs:domain vg:Cl_ClassificationAssignment ;
    rdfs:range vg:Cl_GameClassification ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_classificationBasis a owl:ObjectProperty ;
    rdfs:label "classification Basis"@en ;
    dcterms:identifier "op_classificationBasis" ;
    rdfs:comment "Identifies the criterion used for a classification assignment."@en ;
    rdfs:domain vg:Cl_ClassificationAssignment ;
    rdfs:range vg:Cl_ClassificationCriterion ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasGenre a owl:ObjectProperty ;
    rdfs:label "has Genre"@en ;
    dcterms:identifier "op_hasGenre" ;
    rdfs:comment "Links a video game to a genre value."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_GameGenre ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasMode a owl:ObjectProperty ;
    rdfs:label "has Mode"@en ;
    dcterms:identifier "op_hasMode" ;
    rdfs:comment "Links a video game to a mode value."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_GameMode ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasGameType a owl:ObjectProperty ;
    rdfs:label "has Game Type"@en ;
    dcterms:identifier "op_hasGameType" ;
    rdfs:comment "Links a video game to a broad game-type value."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_GameType ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasRatingAssignment a owl:ObjectProperty ;
    rdfs:label "has Rating Assignment"@en ;
    dcterms:identifier "op_hasRatingAssignment" ;
    rdfs:comment "Links a game or version to a reified content-rating assignment."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion ) ] ;
    rdfs:range vg:Cl_ContentRatingAssignment ;
    owl:inverseOf vg:op_ratedGame ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_ratedGame a owl:ObjectProperty ;
    rdfs:label "rated Game"@en ;
    dcterms:identifier "op_ratedGame" ;
    rdfs:comment "Identifies the game or version rated by an assignment."@en ;
    rdfs:domain vg:Cl_ContentRatingAssignment ;
    rdfs:range [ a owl:Class ; owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion ) ] ;
    owl:inverseOf vg:op_hasRatingAssignment ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_ratingAuthority a owl:ObjectProperty ;
    rdfs:label "rating Authority"@en ;
    dcterms:identifier "op_ratingAuthority" ;
    rdfs:comment "Identifies the authority issuing a content-rating assignment."@en ;
    rdfs:domain vg:Cl_ContentRatingAssignment ;
    rdfs:range vg:Cl_ContentRatingOrganization ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_assignedRating a owl:ObjectProperty ;
    rdfs:label "assigned Rating"@en ;
    dcterms:identifier "op_assignedRating" ;
    rdfs:comment "Identifies the content rating assigned."@en ;
    rdfs:domain vg:Cl_ContentRatingAssignment ;
    rdfs:range vg:Cl_ContentRating ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_appliesInJurisdiction a owl:ObjectProperty ;
    rdfs:label "applies In Jurisdiction"@en ;
    dcterms:identifier "op_appliesInJurisdiction" ;
    rdfs:comment "Identifies a jurisdiction in which a rating assignment or organization applies."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( vg:Cl_ContentRatingAssignment vg:Cl_ContentRatingOrganization ) ] ;
    rdfs:range vg:Cl_Jurisdiction ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_releasedEntity a owl:ObjectProperty ;
    rdfs:label "released Entity"@en ;
    dcterms:identifier "op_releasedEntity" ;
    rdfs:comment "Identifies the entity released in a release event."@en ;
    rdfs:domain vg:Cl_ReleaseEvent ;
    rdfs:range [ a owl:Class ; owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion vg:Cl_ContentExtension ) ] ;
    owl:inverseOf vg:op_hasReleaseEvent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_introducedPlatform a owl:ObjectProperty ;
    rdfs:label "introduced Platform"@en ;
    dcterms:identifier "op_introducedPlatform" ;
    rdfs:comment "Identifies the platform introduced in an introduction event."@en ;
    rdfs:domain vg:Cl_IntroductionEvent ;
    rdfs:range vg:Cl_Platform ;
    owl:inverseOf vg:op_hasIntroductionEvent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasIntroductionTime a owl:ObjectProperty ;
    rdfs:label "has Introduction Time"@en ;
    dcterms:identifier "op_hasIntroductionTime" ;
    rdfs:comment "Links a platform-introduction event to its temporal entity."@en ;
    rdfs:domain vg:Cl_IntroductionEvent ;
    rdfs:range vg:Cl_ReleaseTemporalEntity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_afterReleaseEvent a owl:ObjectProperty ;
    rdfs:label "after Release Event"@en ;
    dcterms:identifier "op_afterReleaseEvent" ;
    rdfs:comment "States that an extension release event occurs after the initial release event bound in the same extension-release situation."@en ;
    rdfs:domain vg:Cl_ReleaseEvent ;
    rdfs:range vg:Cl_ReleaseEvent ;
    owl:propertyChainAxiom (
        [ owl:inverseOf vg:op_releaseSituationExtensionReleaseEvent ]
        vg:op_releaseSituationInitialReleaseEvent
    ) ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_hasPurpose a owl:ObjectProperty ;
    rdfs:label "has Purpose"@en ;
    dcterms:identifier "op_hasPurpose" ;
    rdfs:comment "Links a serious game to a non-entertainment purpose."@en ;
    rdfs:domain vg:Cl_VideoGame ;
    rdfs:range vg:Cl_NonEntertainmentPurpose ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_definesRating a owl:ObjectProperty ;
    rdfs:label "defines Rating"@en ;
    dcterms:identifier "op_definesRating" ;
    rdfs:comment "Links a rating organization to a content-rating value it defines."@en ;
    rdfs:domain vg:Cl_ContentRatingOrganization ;
    rdfs:range vg:Cl_ContentRating ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_platformOperatedBy a owl:ObjectProperty ;
    rdfs:label "platform Operated By"@en ;
    dcterms:identifier "op_platformOperatedBy" ;
    rdfs:comment "Identifies an organization that operates a platform."@en ;
    rdfs:domain vg:Cl_Platform ;
    rdfs:range vg:Cl_Organization ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:op_processingForCloudGame a owl:ObjectProperty ;
    rdfs:label "processing For Cloud Game"@en ;
    dcterms:identifier "op_processingForCloudGame" ;
    rdfs:comment "Identifies the cloud game computed or rendered by a processing activity."@en ;
    rdfs:domain vg:Cl_CloudProcessingActivity ;
    rdfs:range vg:Cl_CloudGame ;
    owl:inverseOf vg:op_hasCloudProcessingActivity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

# Datatype-property declarations

vg:dp_numericValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "numeric Value"@en ;
    dcterms:identifier "dp_numericValue" ;
    rdfs:comment "Records the numeric value of an attribute state."@en ;
    rdfs:domain vg:Cl_AttributeState ;
    rdfs:range xsd:decimal ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:dp_lifeCountValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "life Count Value"@en ;
    dcterms:identifier "dp_lifeCountValue" ;
    rdfs:comment "Records a non-negative life-count value."@en ;
    rdfs:domain vg:Cl_LifeCountState ;
    rdfs:range xsd:nonNegativeInteger ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:dp_yearValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "year Value"@en ;
    dcterms:identifier "dp_yearValue" ;
    rdfs:comment "Records a source-supplied year without fabricating month or day."@en ;
    rdfs:domain vg:Cl_HistoricalYearPeriod ;
    rdfs:range xsd:gYear ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:dp_ratingCode a owl:DatatypeProperty ;
    rdfs:label "rating Code"@en ;
    dcterms:identifier "dp_ratingCode" ;
    rdfs:comment "Records the rating code shown by a content-rating system."@en ;
    rdfs:domain vg:Cl_ContentRating ;
    rdfs:range xsd:string ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:dp_minimumRecommendedAge a owl:DatatypeProperty ;
    rdfs:label "minimum Recommended Age"@en ;
    dcterms:identifier "dp_minimumRecommendedAge" ;
    rdfs:comment "Records a minimum recommended age only where the source explicitly supplies one."@en ;
    rdfs:domain vg:Cl_ContentRating ;
    rdfs:range xsd:nonNegativeInteger ;
    dcterms:source vg:Ind_ManagerTIPDocument .

# Structural restrictions and semantic axioms

vg:Cl_Participation rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_participant ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_Entity
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_participatesIn ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_Event
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_playsRole ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_ParticipantRole
    ] .

vg:Cl_VideoGame rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasInteractionEvent ;
        owl:someValuesFrom vg:Cl_PlayerInteractionEvent
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_requiresPlatform ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_Platform
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_generatesVisualFeedback ;
        owl:someValuesFrom vg:Cl_VisualFeedback
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_usesInteractionInterface ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:unionOf ( vg:Cl_UserInterface vg:Cl_InputDevice )
        ]
    ] ;
    vg:ap_qualitativeClaim "At a bare minimum, a video game requires some level of interactivity or involvement between the player and the medium; the interactivity affects the visual display."@en ;
    vg:ap_planScopeNote "Games are typically designed for one or a limited number of platforms. Only the minimum of one platform is formalized; no maximum is invented."@en .

vg:Cl_PlayerInteractionEvent rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasParticipation ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:intersectionOf (
                vg:Cl_Participation
                [ a owl:Restriction ;
                    owl:onProperty vg:op_playsRole ;
                    owl:someValuesFrom vg:Cl_PlayerRole
                ]
            )
        ]
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_affectsVisualDisplay ;
        owl:someValuesFrom vg:Cl_VisualDisplay
    ] .

vg:Cl_InputDevice rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasFunction ;
        owl:someValuesFrom vg:Cl_InputTranslationFunction
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_translatesAction ;
        owl:someValuesFrom vg:Cl_HumanAction
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_producesGameInput ;
        owl:someValuesFrom vg:Cl_GameInput
    ] .

vg:Cl_DisplayDevice rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasFunction ;
        owl:someValuesFrom vg:Cl_VisualPresentationFunction
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_presentsVisualFeedback ;
        owl:someValuesFrom vg:Cl_VisualFeedback
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_realizesVisualDisplay ;
        owl:someValuesFrom vg:Cl_VisualDisplay
    ] .

vg:Cl_AudioOutputDevice rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasFunction ;
        owl:someValuesFrom vg:Cl_AudioPresentationFunction
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_presentsAudioFeedback ;
        owl:someValuesFrom vg:Cl_AudioFeedback
    ] .

vg:Cl_DeviceFunction rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_functionOf ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_Device
    ] .

vg:Cl_InputTranslationFunction rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_functionTranslatesAction ;
        owl:someValuesFrom vg:Cl_HumanAction
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_functionProducesGameInput ;
        owl:someValuesFrom vg:Cl_GameInput
    ] .

vg:Cl_VisualPresentationFunction rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_functionPresentsVisualFeedback ;
        owl:someValuesFrom vg:Cl_VisualFeedback
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_functionRealizesVisualDisplay ;
        owl:someValuesFrom vg:Cl_VisualDisplay
    ] .

vg:Cl_GameplaySession rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_sessionOfGame ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_VideoGame
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasTemporalExtent ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_BoundedGameplayInterval
    ] ;
    vg:ap_cqDerived true .

vg:Cl_BoundedGameplayInterval rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty time:hasBeginning ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass time:Instant
    ],
    [ a owl:Restriction ;
        owl:onProperty time:hasEnd ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass time:Instant
    ] ;
    vg:ap_cqDerived true .

vg:Cl_InstantaneousEvent rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasTemporalExtent ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass time:Instant
    ] ;
    vg:ap_cqDerived true .

vg:Cl_GameplayEvent rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_occursInGame ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_VideoGame
    ] .

vg:Cl_GainEvent rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasParticipation ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:intersectionOf (
                vg:Cl_Participation
                [ a owl:Restriction ;
                    owl:onProperty vg:op_playsRole ;
                    owl:someValuesFrom vg:Cl_PlayerRole
                ]
            )
        ]
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasParticipation ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:intersectionOf (
                vg:Cl_Participation
                [ a owl:Restriction ;
                    owl:onProperty vg:op_playsRole ;
                    owl:someValuesFrom vg:Cl_AvatarRole
                ]
            )
        ]
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_involvesItem ;
        owl:someValuesFrom vg:Cl_PowerUp
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasOutcome ;
        owl:someValuesFrom vg:Cl_AttributeBoostOutcome
    ] .

vg:Cl_ExtraLifeGainEvent rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_involvesItem ;
        owl:someValuesFrom vg:Cl_ExtraLife
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasOutcome ;
        owl:someValuesFrom vg:Cl_LifeCountIncrementOutcome
    ] .

vg:Cl_LoseEvent rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasParticipation ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:intersectionOf (
                vg:Cl_Participation
                [ a owl:Restriction ;
                    owl:onProperty vg:op_playsRole ;
                    owl:someValuesFrom vg:Cl_PlayerRole
                ]
            )
        ]
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasParticipation ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:intersectionOf (
                vg:Cl_Participation
                [ a owl:Restriction ;
                    owl:onProperty vg:op_playsRole ;
                    owl:someValuesFrom vg:Cl_AvatarRole
                ]
            )
        ]
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasOutcome ;
        owl:someValuesFrom vg:Cl_LifeLossOutcome
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_triggeredBy ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:unionOf ( vg:Cl_HealthAtZeroCondition vg:Cl_EntrapmentCondition )
        ]
    ] .

vg:Cl_HealthAtZeroCondition rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_evidencedByState ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:intersectionOf (
                vg:Cl_AttributeState
                [ a owl:Restriction ;
                    owl:onProperty vg:op_forAttribute ;
                    owl:someValuesFrom vg:Cl_HealthAttribute
                ]
                [ a owl:Restriction ;
                    owl:onProperty vg:dp_numericValue ;
                    owl:hasValue "0"^^xsd:decimal
                ]
            )
        ]
    ] .

vg:Cl_EntrapmentCondition rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_atLocation ;
        owl:someValuesFrom vg:Cl_InescapableLocation
    ] .

vg:Cl_AllLivesLostCondition rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_evidencedByState ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:intersectionOf (
                vg:Cl_LifeCountState
                [ a owl:Restriction ;
                    owl:onProperty vg:dp_lifeCountValue ;
                    owl:hasValue "0"^^xsd:nonNegativeInteger
                ]
            )
        ]
    ] .

vg:Cl_GameOverEvent rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_triggeredBy ;
        owl:someValuesFrom vg:Cl_AllLivesLostCondition
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_triggeredBy ;
        owl:someValuesFrom vg:Cl_NoExtraLifeAvailableCondition
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasOutcome ;
        owl:someValuesFrom vg:Cl_GameOverScreen
    ] .

vg:Cl_ExtraLife rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_canPreventCondition ;
        owl:someValuesFrom vg:Cl_AllLivesLostCondition
    ] .

vg:Cl_AttributeState rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_stateOf ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_Entity
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_forAttribute ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_Attribute
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:dp_numericValue ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:decimal
    ] .

vg:Cl_LifeCountState rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_stateOf ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_Entity
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:dp_lifeCountValue ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:nonNegativeInteger
    ] .

vg:Cl_Platform rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasHardwareComponent ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_HardwareComponent
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasSoftwareComponent ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_SoftwareComponent
    ] .

vg:Cl_ProgrammablePlatform rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_readsMedium ;
        owl:someValuesFrom vg:Cl_GameMedia
    ] .

vg:Cl_MobileGamingPlatform rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_usesOperatingSystem ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:unionOf ( vg:Cl_iOS vg:Cl_Android )
        ]
    ] .

vg:Cl_CloudProcessingActivity rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_computedOn ;
        owl:someValuesFrom vg:Cl_RemoteHardware
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_operatedBy ;
        owl:someValuesFrom vg:Cl_CloudGamingProvider
    ] .

vg:Cl_RemoteHardware rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_operatedBy ;
        owl:someValuesFrom vg:Cl_CloudGamingProvider
    ] .

vg:Cl_CloudGame rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_requiresPlatform ;
        owl:someValuesFrom vg:Cl_CloudGamingPlatform
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasCloudProcessingActivity ;
        owl:someValuesFrom vg:Cl_CloudProcessingActivity
    ] .

vg:Cl_HeadMountedUnit rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasDisplayComponent ;
        owl:someValuesFrom vg:Cl_StereoscopicScreen
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_supportsTechnology ;
        owl:someValuesFrom vg:Cl_MotionTrackingTechnology
    ] .

vg:Cl_VirtualRealityGame rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_requiresPlatform ;
        owl:someValuesFrom vg:Cl_VirtualRealitySystem
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_usesDisplayDevice ;
        owl:someValuesFrom vg:Cl_HeadMountedUnit
    ] .

vg:Cl_ArcadeVideoGame rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_requiresPlatform ;
        owl:someValuesFrom vg:Cl_ArcadePlatform
    ] .

vg:Cl_ConsoleVideoGame rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_requiresPlatform ;
        owl:someValuesFrom vg:Cl_HomeConsole
    ] .

vg:Cl_ComputerGame rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_requiresPlatform ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:unionOf ( vg:Cl_PersonalComputerPlatform vg:Cl_MainframeComputerPlatform )
        ]
    ] .

vg:Cl_BrowserGame rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_requiresPlatform ;
        owl:someValuesFrom vg:Cl_WebBrowserPlatform
    ] .

vg:Cl_MobileGame rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_requiresPlatform ;
        owl:someValuesFrom vg:Cl_MobileGamingPlatform
    ] .

vg:Cl_AugmentedRealityGame rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_requiresPlatform ;
        owl:someValuesFrom vg:Cl_AugmentedRealitySystem
    ] .

vg:Cl_ReleaseEvent rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasReleaseTime ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_ReleaseTemporalEntity
    ] .

vg:Cl_IntroductionEvent rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasIntroductionTime ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_ReleaseTemporalEntity
    ] .

vg:Cl_ReleaseDate rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty time:inXSDDateTimeStamp ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:dateTimeStamp
    ] .

vg:Cl_HistoricalYearPeriod rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:dp_yearValue ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onDataRange xsd:gYear
    ] .

vg:Cl_DevelopmentActivity rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasParticipation ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:intersectionOf (
                vg:Cl_Participation
                [ a owl:Restriction ;
                    owl:onProperty vg:op_playsRole ;
                    owl:someValuesFrom vg:Cl_SourceGameRole
                ]
            )
        ]
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasParticipation ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:intersectionOf (
                vg:Cl_Participation
                [ a owl:Restriction ;
                    owl:onProperty vg:op_playsRole ;
                    owl:someValuesFrom vg:Cl_ResultingVersionRole
                ]
            )
        ]
    ] .

vg:Cl_PortOrConversion rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_generatedByDevelopment ;
        owl:someValuesFrom vg:Cl_PortDevelopmentActivity
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_sourcePlatform ;
        owl:someValuesFrom vg:Cl_Platform
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_targetPlatform ;
        owl:someValuesFrom vg:Cl_Platform
    ] ;
    vg:ap_planScopeNote "For each port instance, the source and target platform must be asserted and explicitly different; OWL does not assume different names denote different individuals."@en .

vg:Cl_Remaster rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_generatedByDevelopment ;
        owl:someValuesFrom vg:Cl_RemasterDevelopmentActivity
    ] ;
    vg:ap_qualitativeClaim "Most of the original game's source code is reused, while art assets, models, and game levels are updated for modern systems; no percentage threshold is asserted."@en .

vg:Cl_Remake rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_generatedByDevelopment ;
        owl:someValuesFrom vg:Cl_RemakeDevelopmentActivity
    ] ;
    vg:ap_qualitativeClaim "A remake significantly reworks the original game and may be produced from scratch; from-scratch development is optional, not necessary."@en .

vg:Cl_ContentExtension rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasExtensionReleaseSituation ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_ExtensionReleaseSituation
    ] ;
    vg:ap_planScopeNote "The canonical extension-release situation binds the extension, its extended game or version, that entity's initial release event, and the extension release event. The two release temporal entities must be explicitly ordered with time:after."@en .

vg:Cl_ExtensionReleaseSituation rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_releaseSituationExtension ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_ContentExtension
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_releaseSituationExtendedEntity ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass [
            a owl:Class ;
            owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion )
        ]
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_releaseSituationInitialReleaseEvent ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_ReleaseEvent
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_releaseSituationExtensionReleaseEvent ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_ReleaseEvent
    ] .

vg:Cl_DownloadableContent rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_distributedOnMedium ;
        owl:someValuesFrom vg:Cl_DigitalDistributionPackage
    ] .

vg:Cl_ClassificationAssignment rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_classifiedGame ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_VideoGame
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_classificationValue ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_GameClassification
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_classificationBasis ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_ClassificationCriterion
    ] .

vg:Cl_ContentRatingAssignment rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_ratedGame ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass [
            a owl:Class ;
            owl:unionOf ( vg:Cl_VideoGame vg:Cl_GameVersion )
        ]
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_ratingAuthority ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_ContentRatingOrganization
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_assignedRating ;
        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_ContentRating
    ],
    [ a owl:Restriction ;
        owl:onProperty vg:op_appliesInJurisdiction ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass vg:Cl_Jurisdiction
    ] .

vg:Cl_GameController
    vg:ap_qualitativeClaim "Gamepads and joysticks are described as the most common game controllers for most consoles; no numeric frequency is asserted."@en .

vg:Cl_GameplayInteractionCriterion
    vg:ap_qualitativeClaim "Gameplay interaction is described as the primary basis for video-game genre classification."@en .

vg:Cl_SeriousGame rdfs:subClassOf
    [ a owl:Restriction ;
        owl:onProperty vg:op_hasPurpose ;
        owl:someValuesFrom vg:Cl_NonEntertainmentPurpose
    ] .

