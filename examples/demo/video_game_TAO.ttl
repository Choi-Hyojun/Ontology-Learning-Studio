# Classification answer-class definitions

vg:Cl_ShooterGame owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        vg:Cl_VideoGame
        [ a owl:Restriction ;
            owl:onProperty vg:op_hasGenre ;
            owl:hasValue vg:Ind_ShooterGenre
        ]
    )
] .

vg:Cl_FirstPersonShooter owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        vg:Cl_VideoGame
        [ a owl:Restriction ;
            owl:onProperty vg:op_hasGenre ;
            owl:hasValue vg:Ind_FirstPersonShooterGenre
        ]
    )
] .

vg:Cl_ThirdPersonShooter owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        vg:Cl_VideoGame
        [ a owl:Restriction ;
            owl:onProperty vg:op_hasGenre ;
            owl:hasValue vg:Ind_ThirdPersonShooterGenre
        ]
    )
] .

vg:Cl_SinglePlayerVideoGame owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        vg:Cl_VideoGame
        [ a owl:Restriction ;
            owl:onProperty vg:op_hasMode ;
            owl:hasValue vg:Ind_SinglePlayerMode
        ]
    )
] .

vg:Cl_MultiplayerVideoGame owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        vg:Cl_VideoGame
        [ a owl:Restriction ;
            owl:onProperty vg:op_hasMode ;
            owl:hasValue vg:Ind_MultiplayerMode
        ]
    )
] .

vg:Cl_SeriousGame owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        vg:Cl_VideoGame
        [ a owl:Restriction ;
            owl:onProperty vg:op_hasGameType ;
            owl:hasValue vg:Ind_SeriousGameType
        ]
    )
] .

vg:Cl_EducationalGame owl:equivalentClass [
    a owl:Class ;
    owl:intersectionOf (
        vg:Cl_VideoGame
        [ a owl:Restriction ;
            owl:onProperty vg:op_hasGameType ;
            owl:hasValue vg:Ind_EducationalGameType
        ]
    )
] .

