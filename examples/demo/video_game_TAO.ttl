# Scope annotations (source-supported and TIP-derived)

vg:Cl_VideoGame
    vg:ap_sourceScopeNote "Most modern video games are audiovisual; audio is commonly delivered through speakers or headphones, and some games support microphone or webcam input for chat or livestreaming."@en .

vg:Cl_InputDevice
    vg:ap_sourceScopeNote "Document examples include joysticks, controllers, keyboards, mice, touchscreens, motion sensors, microphones, webcams, and digital cameras."@en .

vg:Cl_DisplayDevice
    vg:ap_sourceScopeNote "Document examples include television sets, computer monitors, flat-panel displays, touchscreens, projectors, and virtual-reality headsets."@en .

vg:Cl_HomeConsole
    vg:ap_planScopeNote "A home console is a specialized electronic device that commonly connects to a television or monitor and is designed for a dedicated hardware environment."@en .

vg:Cl_HandheldConsole
    vg:ap_planScopeNote "A handheld console integrates the console, screen, speakers, and controls in a portable self-contained unit."@en .

vg:Cl_ArcadePlatform
    vg:ap_planScopeNote "An arcade platform is typically a specialized coin-operated cabinet with built-in console, controls, display, and audio components."@en .

vg:Cl_MobileGamingPlatform
    vg:ap_planScopeNote "Smartphones and tablet computers standardized on iOS and Android made mobile gaming a significant platform; the ontology requires at least one operating system from that union, not both."@en .

vg:Cl_CloudGame
    vg:ap_planScopeNote "A cloud game is computed and rendered on remote hardware operated by the cloud-gaming provider, while player input and output traverse a network."@en .

vg:Cl_VirtualRealityGame
    vg:ap_planScopeNote "Virtual-reality games generally use a special head-mounted unit with stereoscopic screens and motion tracking and may use separate hand controls."@en .

vg:Cl_GameMedia
    vg:ap_planScopeNote "Physical formats include ROM cartridges, magnetic tape, floppy discs, CD-ROMs, DVDs, and flash-memory cards; digital distribution and cloud gaming can remove the need for physical media."@en .

vg:Cl_ContentExtension
    vg:ap_planScopeNote "Expansion packs and downloadable content can provide new content and software patches after an initial release. Each modeled extension has its own explicitly ordered release event."@en .

vg:Cl_GameGenre
    vg:ap_planScopeNote "Genre is generally based on gameplay interaction rather than narrative setting; genre labels can change over time."@en .

vg:Cl_GameMode
    vg:ap_planScopeNote "Mode principally distinguishes single-player and multiplayer use; one game may support both, so these answer classes are not disjoint."@en .

vg:Cl_SeriousGame
    vg:ap_planScopeNote "In a serious game, entertainment may be augmented, overshadowed, or eliminated by another purpose. Educational games are modeled as serious games."@en .

vg:Cl_ContentRating
    vg:ap_planScopeNote "Content ratings commonly identify a target age group and may add descriptors for violence, sexual content, drugs, alcohol, or gambling."@en .

# Synthetic positive regression fixture for the competency questions

vg:Ind_CQFixtureGame a vg:Cl_VideoGame,
        vg:Cl_FirstPersonShooter,
        vg:Cl_SinglePlayerVideoGame,
        vg:Cl_MultiplayerVideoGame,
        vg:Cl_SeriousGame,
        vg:Cl_EducationalGame,
        vg:Cl_CQRegressionFixture ;
    rdfs:label "CQ fixture video game"@en ;
    dcterms:title "CQ Fixture Game"@en ;
    dcterms:identifier "Ind_CQFixtureGame" ;
    vg:op_requiresPlatform vg:Ind_CQFixturePlatform ;
    vg:op_designedForPlatform vg:Ind_CQFixturePlatform ;
    vg:op_hasInteractionEvent vg:Ind_CQFixtureInteractionEvent ;
    vg:op_usesInputDevice vg:Ind_CQFixtureGamepad ;
    vg:op_usesInteractionInterface vg:Ind_CQFixtureGamepad, vg:Ind_CQFixtureHUD ;
    vg:op_usesUserInterface vg:Ind_CQFixtureHUD ;
    vg:op_usesDisplayDevice vg:Ind_CQFixtureDisplayDevice ;
    vg:op_generatesVisualFeedback vg:Ind_CQFixtureVisualFeedback ;
    vg:op_generatesAudioFeedback vg:Ind_CQFixtureAudioFeedback ;
    vg:op_generatesHapticFeedback vg:Ind_CQFixtureHapticFeedback ;
    vg:op_distributedOnMedium vg:Ind_ROMCartridgeMedium ;
    vg:op_hasReleaseEvent vg:Ind_CQFixtureInitialReleaseEvent ;
    vg:op_hasInitialReleaseEvent vg:Ind_CQFixtureInitialReleaseEvent ;
    vg:op_hasGenre vg:Ind_ShooterGenre, vg:Ind_FirstPersonShooterGenre ;
    vg:op_hasMode vg:Ind_SinglePlayerMode, vg:Ind_MultiplayerMode ;
    vg:op_hasGameType vg:Ind_SeriousGameType, vg:Ind_EducationalGameType ;
    vg:op_hasPurpose vg:Ind_NonEntertainmentPurpose ;
    vg:op_hasClassificationAssignment vg:Ind_CQFixtureShooterAssignment,
        vg:Ind_CQFixtureFPSAssignment,
        vg:Ind_CQFixtureSinglePlayerAssignment,
        vg:Ind_CQFixtureMultiplayerAssignment,
        vg:Ind_CQFixtureSeriousTypeAssignment,
        vg:Ind_CQFixtureEducationalTypeAssignment ;
    vg:op_hasRatingAssignment vg:Ind_CQFixtureESRBAssignment,
        vg:Ind_CQFixturePEGIAssignment,
        vg:Ind_CQFixtureCEROAssignment ;
    vg:ap_syntheticFixture true ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Ind_CQFixturePlatform a vg:Cl_ProgrammablePlatform, vg:Cl_CQRegressionFixture ;
    rdfs:label "CQ fixture platform"@en ;
    dcterms:identifier "Ind_CQFixturePlatform" ;
    vg:op_hasHardwareComponent vg:Ind_CQFixtureHardwareComponent, vg:Ind_CQFixtureGamepad ;
    vg:op_hasSoftwareComponent vg:Ind_CQFixtureSoftwareComponent ;
    vg:op_readsMedium vg:Ind_ROMCartridgeMedium ;
    vg:op_connectsToDisplay vg:Ind_CQFixtureDisplayDevice ;
    vg:op_hasAudioOutputDevice vg:Ind_CQFixtureSpeaker ;
    vg:ap_syntheticFixture true ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Ind_CQFixtureHardwareComponent a vg:Cl_HardwareComponent, vg:Cl_CQRegressionFixture ;
    rdfs:label "CQ fixture hardware component"@en ;
    dcterms:identifier "Ind_CQFixtureHardwareComponent" ;
    vg:ap_syntheticFixture true ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Ind_CQFixtureSoftwareComponent a vg:Cl_SoftwareComponent, vg:Cl_CQRegressionFixture ;
    rdfs:label "CQ fixture software component"@en ;
    dcterms:identifier "Ind_CQFixtureSoftwareComponent" ;
    vg:ap_syntheticFixture true ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Ind_CQFixtureButtonPress a vg:Cl_HumanAction, vg:Cl_CQRegressionFixture ;
    rdfs:label "CQ fixture button press"@en ;
    dcterms:identifier "Ind_CQFixtureButtonPress" ;
    vg:ap_syntheticFixture true ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Ind_CQFixtureJumpCommand a vg:Cl_GameInput, vg:Cl_CQRegressionFixture ;
    rdfs:label "CQ fixture jump command"@en ;
    dcterms:identifier "Ind_CQFixtureJumpCommand" ;
    vg:ap_syntheticFixture true ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Ind_CQFixtureInputTranslationFunction a vg:Cl_InputTranslationFunction, vg:Cl_CQRegressionFixture ;
    rdfs:label "CQ fixture input-translation function"@en ;
    dcterms:identifier "Ind_CQFixtureInputTranslationFunction" ;
    vg:op_functionOf vg:Ind_CQFixtureGamepad ;
    vg:op_functionTranslatesAction vg:Ind_CQFixtureButtonPress ;
    vg:op_functionProducesGameInput vg:Ind_CQFixtureJumpCommand ;
    vg:ap_syntheticFixture true ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Ind_CQFixtureGamepad a vg:Cl_Gamepad, vg:Cl_CQRegressionFixture ;
    rdfs:label "CQ fixture gamepad"@en ;
    dcterms:identifier "Ind_CQFixtureGamepad" ;
    vg:op_hasFunction vg:Ind_CQFixtureInputTranslationFunction ;
    vg:op_translatesAction vg:Ind_CQFixtureButtonPress ;
    vg:op_producesGameInput vg:Ind_CQFixtureJumpCommand ;
    vg:op_usedInInteraction vg:Ind_CQFixtureInteractionEvent ;
    vg:op_supportsTechnology vg:Ind_HapticTechnology ;
    vg:op_realizesHapticFeedback vg:Ind_CQFixtureHapticFeedback ;
    vg:ap_syntheticFixture true ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Ind_CQFixtureJoystick a vg:Cl_Joystick, vg:Cl_CQRegressionFixture ;
    rdfs:label "CQ fixture joystick"@en ;
    dcterms:identifier "Ind_CQFixtureJoystick" ;
    vg:op_hasFunction vg:Ind_CQFixtureJoystickTranslationFunction ;
    vg:op_translatesAction vg:Ind_CQFixtureDirectionalAction ;
    vg:op_producesGameInput vg:Ind_CQFixtureDirectionalInput ;
    vg:ap_syntheticFixture true ;
