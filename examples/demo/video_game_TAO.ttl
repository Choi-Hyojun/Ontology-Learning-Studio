# Video Game Ontology — assurance-corrected Turtle.
# Plan/CQ-derived assertions cite the manager TIP; the limited-scope description is used only for the game definition and device/feedback material.

@prefix vg: <https://w3id.org/videogame-ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Ontology metadata and provenance

<https://w3id.org/videogame-ontology> a owl:Ontology ;
    dcterms:title "Video Game Ontology"@en ;
    dcterms:description "An OWL 2 ontology for video games, gameplay events, platforms, versions, media, classifications, and content-rating organizations."@en ;
    dcterms:identifier "videogame-ontology" ;
    dcterms:source vg:Ind_OntologyInstructionDocument,
        vg:Ind_ManagerTIPDocument,
        vg:Ind_VideoGameDescriptionDocument ;
    owl:imports <http://www.w3.org/2006/time>,
        <http://www.w3.org/ns/prov-o#>,
        <http://www.w3.org/2004/02/skos/core> ;
    owl:versionInfo "1.0.0" .

vg:Ind_OntologyInstructionDocument a dcterms:BibliographicResource ;
    dcterms:title "ontology_instruction.txt" ;
    dcterms:identifier "ontology_instruction.txt" .

vg:Ind_ManagerTIPDocument a dcterms:BibliographicResource ;
    dcterms:title "videogame_tip_document_50.md" ;
    dcterms:identifier "videogame_tip_document_50.md" .

vg:Ind_VideoGameDescriptionDocument a dcterms:BibliographicResource ;
    dcterms:title "Video Game Description.txt" ;
    dcterms:identifier "Video Game Description.txt" ;
    rdfs:comment "Limited-scope source for the video-game definition and input, display, audio, haptic, microphone, and webcam material."@en .

vg:ap_sourceScopeNote a owl:AnnotationProperty ;
    rdfs:label "source scope note"@en ;
    rdfs:comment "Preserves a source-supplied scope statement without converting qualitative language into an invented numeric or closed-world restriction."@en .

vg:ap_planScopeNote a owl:AnnotationProperty ;
    rdfs:label "implementation-plan scope note"@en ;
    rdfs:comment "Preserves a manager-TIP or competency-question scope statement without attributing it to the limited-scope source description."@en ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:ap_qualitativeClaim a owl:AnnotationProperty ;
    rdfs:label "qualitative claim"@en ;
    rdfs:comment "Records source language such as most, primarily, iconic, or limited without inventing thresholds."@en .

vg:ap_cqDerived a owl:AnnotationProperty ;
    rdfs:label "competency-question derived"@en ;
    rdfs:comment "Marks a construct introduced by the competency questions rather than asserted by the source text."@en .

vg:ap_syntheticFixture a owl:AnnotationProperty ;
    rdfs:label "synthetic fixture"@en ;
    rdfs:comment "Marks an individual created solely as a positive competency-question regression fixture."@en .

vg:ap_answersCQ a owl:AnnotationProperty ;
    rdfs:label "answers competency question"@en ;
    rdfs:comment "Associates an ontology term with a competency-question identifier."@en .

# Class declarations

vg:Cl_Entity a owl:Class ;
    rdfs:label "Entity"@en ;
    dcterms:identifier "Cl_Entity" ;
    rdfs:comment "Most general local class for entities represented in the ontology."@en ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    dcterms:identifier "Cl_Agent" ;
    rdfs:comment "An entity capable of bearing roles or carrying out activities."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    rdfs:subClassOf prov:Agent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_Person a owl:Class ;
    rdfs:label "Person"@en ;
    dcterms:identifier "Cl_Person" ;
    rdfs:comment "A human agent who may participate in gameplay or development."@en ;
    rdfs:subClassOf vg:Cl_Agent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    dcterms:identifier "Cl_Organization" ;
    rdfs:comment "An organized agent such as a company, provider, ratings body, or coalition."@en ;
    rdfs:subClassOf vg:Cl_Agent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_Role a owl:Class ;
    rdfs:label "Role"@en ;
    dcterms:identifier "Cl_Role" ;
    rdfs:comment "A context-dependent function borne by an entity."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ParticipantRole a owl:Class ;
    rdfs:label "Participant Role"@en ;
    dcterms:identifier "Cl_ParticipantRole" ;
    rdfs:comment "A role borne by an entity in an event or activity."@en ;
    rdfs:subClassOf vg:Cl_Role ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_Participation a owl:Class ;
    rdfs:label "Participation"@en ;
    dcterms:identifier "Cl_Participation" ;
    rdfs:comment "A reified relation linking one participant, one event, and one participant role."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_Event a owl:Class ;
    rdfs:label "Event"@en ;
    dcterms:identifier "Cl_Event" ;
    rdfs:comment "An occurrence with participants and, when known, a temporal extent."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GameplayCondition a owl:Class ;
    rdfs:label "Gameplay Condition"@en ;
    dcterms:identifier "Cl_GameplayCondition" ;
    rdfs:comment "A condition that can trigger or constrain a gameplay event."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GameplayOutcome a owl:Class ;
    rdfs:label "Gameplay Outcome"@en ;
    dcterms:identifier "Cl_GameplayOutcome" ;
    rdfs:comment "An outcome produced by a gameplay event."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_Location a owl:Class ;
    rdfs:label "Location"@en ;
    dcterms:identifier "Cl_Location" ;
    rdfs:comment "A spatial entity or place relevant to gameplay."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_Jurisdiction a owl:Class ;
    rdfs:label "Jurisdiction"@en ;
    dcterms:identifier "Cl_Jurisdiction" ;
    rdfs:comment "A national, regional, or other territorial scope for rating authority."@en ;
    rdfs:subClassOf vg:Cl_Location ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_CQRegressionFixture a owl:Class ;
    rdfs:label "CQ Regression Fixture"@en ;
    dcterms:identifier "Cl_CQRegressionFixture" ;
    rdfs:comment "A synthetic entity used only to demonstrate and test competency-question query paths."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ElectronicGame a owl:Class ;
    rdfs:label "Electronic Game"@en ;
    dcterms:identifier "Cl_ElectronicGame" ;
    rdfs:comment "A game implemented using electronic components."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_VideoGame a owl:Class ;
    rdfs:label "Video Game"@en ;
    dcterms:identifier "Cl_VideoGame" ;
    rdfs:comment "An electronic game in which player interaction through an interface or input device generates visual feedback."@en ;
    skos:altLabel "computer game"@en ;
    skos:altLabel "digital game"@en ;
    skos:altLabel "TV game"@en ;
    rdfs:subClassOf vg:Cl_ElectronicGame ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:Cl_UserInterface a owl:Class ;
    rdfs:label "User Interface"@en ;
    dcterms:identifier "Cl_UserInterface" ;
    rdfs:comment "An interface through which game information or controls are presented to a player."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:Cl_HumanAction a owl:Class ;
    rdfs:label "Human Action"@en ;
    dcterms:identifier "Cl_HumanAction" ;
    rdfs:comment "A physical or communicative action performed by a person and translated into game input."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:Cl_GameInput a owl:Class ;
    rdfs:label "Game Input"@en ;
    dcterms:identifier "Cl_GameInput" ;
    rdfs:comment "A signal or command supplied to a video game."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_SensoryFeedback a owl:Class ;
    rdfs:label "Sensory Feedback"@en ;
    dcterms:identifier "Cl_SensoryFeedback" ;
    rdfs:comment "Feedback presented by a game through a sensory modality."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_VideoGameDescriptionDocument .

vg:Cl_VisualFeedback a owl:Class ;
    rdfs:label "Visual Feedback"@en ;
    dcterms:identifier "Cl_VisualFeedback" ;
    rdfs:comment "Visual information generated by a video game in response to operation or interaction."@en ;
    rdfs:subClassOf vg:Cl_SensoryFeedback ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:Cl_AudioFeedback a owl:Class ;
    rdfs:label "Audio Feedback"@en ;
    dcterms:identifier "Cl_AudioFeedback" ;
    rdfs:comment "Audio output, including sound effects or music, that complements game graphics."@en ;
    rdfs:subClassOf vg:Cl_SensoryFeedback ;
    dcterms:source vg:Ind_VideoGameDescriptionDocument .

vg:Cl_HapticFeedback a owl:Class ;
    rdfs:label "Haptic Feedback"@en ;
    dcterms:identifier "Cl_HapticFeedback" ;
    rdfs:comment "Tactile feedback produced to simulate or communicate an in-game occurrence."@en ;
    rdfs:subClassOf vg:Cl_SensoryFeedback ;
    dcterms:source vg:Ind_VideoGameDescriptionDocument .

vg:Cl_VisualDisplay a owl:Class ;
    rdfs:label "Visual Display"@en ;
    dcterms:identifier "Cl_VisualDisplay" ;
    rdfs:comment "The visual presentation or rendered display affected by player interaction."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:Cl_PlayerInteractionEvent a owl:Class ;
    rdfs:label "Player Interaction Event"@en ;
    dcterms:identifier "Cl_PlayerInteractionEvent" ;
    rdfs:comment "An event in which a player interacts with a video game and affects its visual display."@en ;
    rdfs:subClassOf vg:Cl_GameplayEvent ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:Cl_PlayerRole a owl:Class ;
    rdfs:label "Player Role"@en ;
    dcterms:identifier "Cl_PlayerRole" ;
    rdfs:comment "The context-dependent role borne by a person who interacts with a video game."@en ;
    rdfs:subClassOf vg:Cl_ParticipantRole ;
    dcterms:source vg:Ind_ManagerTIPDocument, vg:Ind_VideoGameDescriptionDocument .

vg:Cl_Character a owl:Class ;
    rdfs:label "Character"@en ;
    dcterms:identifier "Cl_Character" ;
    rdfs:comment "An in-game character that can participate in gameplay."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_Avatar a owl:Class ;
    rdfs:label "Avatar"@en ;
    dcterms:identifier "Cl_Avatar" ;
    rdfs:comment "A character through which a player acts during gameplay."@en ;
    rdfs:subClassOf vg:Cl_Character ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_AvatarRole a owl:Class ;
    rdfs:label "Avatar Role"@en ;
    dcterms:identifier "Cl_AvatarRole" ;
    rdfs:comment "The contextual role of a character acting as the player's avatar in an event."@en ;
    rdfs:subClassOf vg:Cl_ParticipantRole ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ReleasedEntityRole a owl:Class ;
    rdfs:label "Released Entity Role"@en ;
    dcterms:identifier "Cl_ReleasedEntityRole" ;
    rdfs:comment "The role of a game, version, or extension as the entity released in a release event."@en ;
    rdfs:subClassOf vg:Cl_ParticipantRole ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_IntroducedPlatformRole a owl:Class ;
    rdfs:label "Introduced Platform Role"@en ;
    dcterms:identifier "Cl_IntroducedPlatformRole" ;
    rdfs:comment "The role of a platform as the entity introduced in an introduction event."@en ;
    rdfs:subClassOf vg:Cl_ParticipantRole ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GameplaySession a owl:Class ;
    rdfs:label "Gameplay Session"@en ;
    dcterms:identifier "Cl_GameplaySession" ;
    rdfs:comment "One bounded episode of gameplay, such as a round, race, or match segment."@en ;
    rdfs:subClassOf vg:Cl_Event ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_BoundedGameplayInterval a owl:Class ;
    rdfs:label "Bounded Gameplay Interval"@en ;
    dcterms:identifier "Cl_BoundedGameplayInterval" ;
    rdfs:comment "A gameplay interval having one beginning instant and one ending instant."@en ;
    rdfs:subClassOf time:Interval ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_InstantaneousEvent a owl:Class ;
    rdfs:label "Instantaneous Event"@en ;
    dcterms:identifier "Cl_InstantaneousEvent" ;
    rdfs:comment "An event recorded at exactly one time instant."@en ;
    rdfs:subClassOf vg:Cl_Event ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GameplayEvent a owl:Class ;
    rdfs:label "Gameplay Event"@en ;
    dcterms:identifier "Cl_GameplayEvent" ;
    rdfs:comment "An occurrence during play in exactly one video-game context."@en ;
    rdfs:subClassOf vg:Cl_Event ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GainEvent a owl:Class ;
    rdfs:label "Gain Event"@en ;
    dcterms:identifier "Cl_GainEvent" ;
    rdfs:comment "An instantaneous gameplay event in which an item such as a power-up is collected."@en ;
    rdfs:subClassOf vg:Cl_GameplayEvent ;
    rdfs:subClassOf vg:Cl_InstantaneousEvent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ExtraLifeGainEvent a owl:Class ;
    rdfs:label "Extra Life Gain Event"@en ;
    dcterms:identifier "Cl_ExtraLifeGainEvent" ;
    rdfs:comment "An instantaneous event in which an extra-life item increments a life count."@en ;
    rdfs:subClassOf vg:Cl_GameplayEvent ;
    rdfs:subClassOf vg:Cl_InstantaneousEvent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_LoseEvent a owl:Class ;
    rdfs:label "Lose Event"@en ;
    dcterms:identifier "Cl_LoseEvent" ;
    rdfs:comment "An instantaneous gameplay event in which a player loses one life."@en ;
    rdfs:subClassOf vg:Cl_GameplayEvent ;
    rdfs:subClassOf vg:Cl_InstantaneousEvent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_MenuEvent a owl:Class ;
    rdfs:label "Menu Event"@en ;
    dcterms:identifier "Cl_MenuEvent" ;
    rdfs:comment "An event that presents or enters a game menu or screen state."@en ;
    rdfs:subClassOf vg:Cl_Event ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GameOverEvent a owl:Class ;
    rdfs:label "Game Over Event"@en ;
    dcterms:identifier "Cl_GameOverEvent" ;
    rdfs:comment "The gameplay and menu event reached after all lives are lost and no extra life is available."@en ;
    rdfs:subClassOf vg:Cl_MenuEvent ;
    rdfs:subClassOf vg:Cl_GameplayEvent ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_Item a owl:Class ;
    rdfs:label "Item"@en ;
    dcterms:identifier "Cl_Item" ;
    rdfs:comment "A gameplay object that can participate in an event and alter player or avatar state."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_PowerUp a owl:Class ;
    rdfs:label "Power Up"@en ;
    dcterms:identifier "Cl_PowerUp" ;
    rdfs:comment "An item whose collection boosts one or more avatar attributes."@en ;
    rdfs:subClassOf vg:Cl_Item ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ExtraLife a owl:Class ;
    rdfs:label "Extra Life"@en ;
    dcterms:identifier "Cl_ExtraLife" ;
    rdfs:comment "An item that grants another life; also called a 1-UP."@en ;
    skos:altLabel "1-UP"@en ;
    rdfs:subClassOf vg:Cl_Item ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_Attribute a owl:Class ;
    rdfs:label "Attribute"@en ;
    dcterms:identifier "Cl_Attribute" ;
    rdfs:comment "A mutable characteristic of an avatar or other gameplay entity."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_HealthAttribute a owl:Class ;
    rdfs:label "Health Attribute"@en ;
    dcterms:identifier "Cl_HealthAttribute" ;
    rdfs:comment "The attribute representing an avatar's health."@en ;
    rdfs:subClassOf vg:Cl_Attribute ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_AttributeState a owl:Class ;
    rdfs:label "Attribute State"@en ;
    dcterms:identifier "Cl_AttributeState" ;
    rdfs:comment "A temporalized numeric state of an attribute for an entity."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_LifeCountState a owl:Class ;
    rdfs:label "Life Count State"@en ;
    dcterms:identifier "Cl_LifeCountState" ;
    rdfs:comment "A temporalized non-negative life-count state for an entity."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_HealthAtZeroCondition a owl:Class ;
    rdfs:label "Health At Zero Condition"@en ;
    dcterms:identifier "Cl_HealthAtZeroCondition" ;
    rdfs:comment "A trigger condition evidenced by an avatar health state whose numeric value is zero."@en ;
    rdfs:subClassOf vg:Cl_GameplayCondition ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_EntrapmentCondition a owl:Class ;
    rdfs:label "Entrapment Condition"@en ;
    dcterms:identifier "Cl_EntrapmentCondition" ;
    rdfs:comment "A trigger condition in which an avatar is in an impossible-to-escape location."@en ;
    rdfs:subClassOf vg:Cl_GameplayCondition ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_InescapableLocation a owl:Class ;
    rdfs:label "Inescapable Location"@en ;
    dcterms:identifier "Cl_InescapableLocation" ;
    rdfs:comment "A gameplay location from which the avatar cannot escape."@en ;
    rdfs:subClassOf vg:Cl_Location ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_AllLivesLostCondition a owl:Class ;
    rdfs:label "All Lives Lost Condition"@en ;
    dcterms:identifier "Cl_AllLivesLostCondition" ;
    rdfs:comment "A condition evidenced by a life-count state with value zero."@en ;
    rdfs:subClassOf vg:Cl_GameplayCondition ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_NoExtraLifeAvailableCondition a owl:Class ;
    rdfs:label "No Extra Life Available Condition"@en ;
    dcterms:identifier "Cl_NoExtraLifeAvailableCondition" ;
    rdfs:comment "An explicit condition stating that no extra life is available."@en ;
    rdfs:subClassOf vg:Cl_GameplayCondition ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_AttributeBoostOutcome a owl:Class ;
    rdfs:label "Attribute Boost Outcome"@en ;
    dcterms:identifier "Cl_AttributeBoostOutcome" ;
    rdfs:comment "An outcome that increases an avatar attribute."@en ;
    rdfs:subClassOf vg:Cl_GameplayOutcome ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_LifeLossOutcome a owl:Class ;
    rdfs:label "Life Loss Outcome"@en ;
    dcterms:identifier "Cl_LifeLossOutcome" ;
    rdfs:comment "An outcome that decreases an entity's life count."@en ;
    rdfs:subClassOf vg:Cl_GameplayOutcome ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_LifeCountIncrementOutcome a owl:Class ;
    rdfs:label "Life Count Increment Outcome"@en ;
    dcterms:identifier "Cl_LifeCountIncrementOutcome" ;
    rdfs:comment "An outcome that increments an entity's life count."@en ;
    rdfs:subClassOf vg:Cl_GameplayOutcome ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_GameOverScreen a owl:Class ;
    rdfs:label "Game Over Screen"@en ;
    dcterms:identifier "Cl_GameOverScreen" ;
    rdfs:comment "The visual-display outcome presented when game over is reached."@en ;
    rdfs:subClassOf vg:Cl_GameplayOutcome ;
    rdfs:subClassOf vg:Cl_VisualDisplay ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_VictoryCondition a owl:Class ;
    rdfs:label "Victory Condition"@en ;
    dcterms:identifier "Cl_VictoryCondition" ;
    rdfs:comment "A condition whose satisfaction constitutes victory or completion."@en ;
    rdfs:subClassOf vg:Cl_GameplayCondition ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_HeadsUpDisplay a owl:Class ;
    rdfs:label "Heads Up Display"@en ;
    dcterms:identifier "Cl_HeadsUpDisplay" ;
    rdfs:comment "An on-screen interface presented over the rendered game."@en ;
    rdfs:subClassOf vg:Cl_UserInterface ;
    rdfs:subClassOf vg:Cl_VisualDisplay ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_TitleScreen a owl:Class ;
    rdfs:label "Title Screen"@en ;
    dcterms:identifier "Cl_TitleScreen" ;
    rdfs:comment "The initial screen from which a player may review options or start play."@en ;
    rdfs:subClassOf vg:Cl_UserInterface ;
    rdfs:subClassOf vg:Cl_VisualDisplay ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_BossCharacter a owl:Class ;
    rdfs:label "Boss Character"@en ;
    dcterms:identifier "Cl_BossCharacter" ;
    rdfs:comment "A character that must be defeated to continue or complete a level."@en ;
    rdfs:subClassOf vg:Cl_Character ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_SavePoint a owl:Class ;
    rdfs:label "Save Point"@en ;
    dcterms:identifier "Cl_SavePoint" ;
    rdfs:comment "An intermediate point at which a saved game can be created."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_SavedGame a owl:Class ;
    rdfs:label "Saved Game"@en ;
    dcterms:identifier "Cl_SavedGame" ;
    rdfs:comment "A stored game state that can be used to resume play."@en ;
    rdfs:subClassOf vg:Cl_Entity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ReleaseEvent a owl:Class ;
    rdfs:label "Release Event"@en ;
    dcterms:identifier "Cl_ReleaseEvent" ;
    rdfs:comment "An event in which a game, game version, or content extension is released."@en ;
    rdfs:subClassOf vg:Cl_Event ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_IntroductionEvent a owl:Class ;
    rdfs:label "Introduction Event"@en ;
    dcterms:identifier "Cl_IntroductionEvent" ;
    rdfs:comment "An event in which a platform is introduced."@en ;
    rdfs:subClassOf vg:Cl_Event ;
    dcterms:source vg:Ind_ManagerTIPDocument .

vg:Cl_ReleaseTemporalEntity a owl:Class ;
    rdfs:label "Release Temporal Entity"@en ;
    dcterms:identifier "Cl_ReleaseTemporalEntity" ;
    rdfs:comment "A temporal entity associated with a release or introduction."@en ;
    rdfs:subClassOf time:TemporalEntity ;
    dcterms:source vg:Ind_ManagerTIPDocument .

