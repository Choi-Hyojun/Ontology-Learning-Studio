<?xml version="1.0"?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#"
     xml:base="https://example.org/video-game-ontology"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     ontologyIRI="https://example.org/video-game-ontology">
    <Prefix name="" IRI="https://example.org/video-game-ontology#"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <Prefix name="xml" IRI="http://www.w3.org/XML/1998/namespace"/>
    <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
    <Prefix name="prov" IRI="http://www.w3.org/ns/prov#"/>
    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
    <Prefix name="skos" IRI="http://www.w3.org/2004/02/skos/core#"/>
    <Prefix name="time" IRI="http://www.w3.org/2006/time#"/>
    <Prefix name="schema" IRI="https://schema.org/"/>
    <Prefix name="dcterms" IRI="http://purl.org/dc/terms/"/>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:description"/>
        <Literal xml:lang="en">A refined ontology for video games, releases, platforms, media and distribution, extensions and adaptations, input/output devices, gameplay, organizations, engines, monetization, ratings, reviews, historical context, competitive contexts, provenance, external links, release windows, series, and gameplay sessions. The model reuses Dublin Core Terms, PROV-O, SKOS/SKOS-XL, OWL-Time, and Schema.org where their terms already express the intended semantics.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:modified"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#date">2026-09-05</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="dcterms:title"/>
        <Literal xml:lang="en">Video Game Ontology</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">:releaseOf specializes schema:exampleOfWork, preserving the ontology&apos;s distinction between an abstract VideoGame and a concrete GameRelease.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">Abstract video games and concrete game releases remain distinct. GameRelease models an edition/version/release of a VideoGame rather than collapsing both levels into schema:VideoGame.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">External identifiers reuse dcterms:identifier or schema:identifier directly. When the assigning system must be explicit, use schema:identifier with a schema:PropertyValue carrying schema:propertyID and schema:value rather than a local external-identifier predicate.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">External related-resource links reuse rdfs:seeAlso; owl:sameAs and skos:exactMatch are reserved for stronger identity or exact-concept mappings.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">For generic metadata, use dcterms:title, dcterms:identifier, and dcterms:description directly. Use schema:version for version literals on releases or cited source resources rather than introducing local duplicates.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">Game extensions may use dcterms:creator with a prov:Agent creator. Video games and releases may use prov:qualifiedAssociation with prov:agent and prov:hadRole for role-qualified organizational participation.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">GameplaySession is a prov:Activity. :usesGameRelease and :usedInputDevice specialize prov:used, while :hasPlayer specializes prov:wasAssociatedWith.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">Genre hierarchies are modeled as :Genre instances using SKOS broader/narrower relations. This avoids duplicating the same genre taxonomy as an OWL class hierarchy.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">Input-device support uses :supportsInputDevice and output routing uses :supportsOutputDevice; :providesFeedbackCapability describes the kind of feedback available. No additional synonymous controller/output properties are introduced.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">Organization participation is represented with :developedBy, :publishedBy, and :distributedBy plus PROV qualified associations and named PROV roles. Developer and publisher are therefore modeled as contextual roles rather than redundant subclasses of :Organization.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">Release windows and historical periods reuse OWL-Time: time:hasBeginning and time:hasEnd point to time:Instant values, whose calendar dates may be expressed with time:inXSDDate.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">Reviews reuse schema:itemReviewed, schema:reviewBody, schema:reviewRating, and schema:ratingValue instead of parallel local review-target or rating-value properties.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">SKOS concepts may use skos:prefLabel, skos:altLabel, skos:broader, skos:narrower, skos:scopeNote, and skos:historyNote. SKOS-XL labels may use skosxl:prefLabel, skosxl:altLabel, and skosxl:literalForm when label resources need contextual metadata.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">SKOS-XL may be used when labels need region or historical-period context; :associatedWithRegion and :associatedWithHistoricalPeriod are specialized subproperties of Dublin Core spatial and temporal relations.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">Standard metadata terms are reused directly where they already match the intended meaning: dcterms:title, dcterms:identifier, dcterms:description, dcterms:source, schema:version, schema:reviewBody, PROV derivation/influence properties, and OWL-Time interval boundaries.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">Use dcterms:source for ordinary source citation and prov:hadPrimarySource when the stronger PROV primary-source relation is intended. Provenance records may use prov:wasDerivedFrom, prov:wasAttributedTo, and prov:generatedAtTime.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="en">Use prov:wasDerivedFrom for generic derivation and prov:wasInfluencedBy for generic influence. The domain-specific :portOf, :conversionOf, :remasterOf, and :remakeOf properties specialize prov:wasDerivedFrom.</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal xml:lang="en">2.1-refined</Literal>
    </Annotation>
