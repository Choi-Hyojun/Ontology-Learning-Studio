###  https://example.org/video-game-ontology#VideoGame
:VideoGame rdf:type owl:Class ;
           rdfs:subClassOf [ rdf:type owl:Restriction ;
                             owl:onProperty :hasGameMode ;
                             owl:someValuesFrom :GameMode
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasGameplayMechanic ;
                             owl:someValuesFrom :GameplayMechanic
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :hasGenre ;
                             owl:someValuesFrom :Genre
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :supportsInputDevice ;
                             owl:someValuesFrom :InputDevice
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :supportsOutputDevice ;
                             owl:someValuesFrom :OutputDevice
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :providesFeedbackCapability ;
                             owl:hasValue :VisualFeedbackCapability
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :intendedForPlatform ;
                             owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onClass :Platform
                           ] ;
           rdfs:comment "A video game considered as a creative work independent of a particular release."@en ;
           rdfs:label "Video Game"@en .


