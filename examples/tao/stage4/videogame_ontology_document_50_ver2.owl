  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#influencedByTheme">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">influenced by theme</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/videogame#Cl_ContentRating"/>
    <rdfs:range rdf:resource="http://www.example.org/videogame#Cl_ContentTheme"/>
    <qualification xml:lang="en">Most review is based on violence, including its type and graphic presentation, and sexual content. Drug use, alcohol use and gambling may also be identified. No actual game rating is supplied.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Content rating, line 147</sourceLocator>
  </rdf:Description>
