  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_WinningCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Winning condition</rdfs:label>
    <qualification xml:lang="en">Most video games feature a victory condition, such as a scoring mechanism or final boss fight, but a winning condition is not necessary for video-game status.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Definition, line 27</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_ContentRating">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Content rating</rdfs:label>
    <rdfs:comment xml:lang="en">An assigned classification of game content, distinct from the system and organization used to produce it.</rdfs:comment>
    <qualification xml:lang="en">The document identifies target-age appropriateness, with most content review considering violence and sexual content; drug use, alcohol use and gambling may also influence ratings.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Content rating, line 147</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_CoreGame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Core game</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/videogame#Cl_VideoGame"/>
    <rdfs:subClassOf rdf:nodeID="nc06c151c573947668238dde3362ab768b53"/>
    <qualification xml:lang="en">Also called hard-core games. Typically require a fair amount of time to learn and master and are most appealing to gamers rather than a broader audience. No numeric learning or mastery duration is specified.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Core games, line 127</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#hasWinningCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has winning condition</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/videogame#Cl_VideoGame"/>
    <rdfs:range rdf:resource="http://www.example.org/videogame#Cl_WinningCondition"/>
    <qualification xml:lang="en">Most games have some victory condition, but interaction with a game world can support video-game status without one.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Definition, line 27</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_GamePurpose">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Game purpose</rdfs:label>
    <rdfs:comment xml:lang="en">A purpose motivating game design, rather than a guaranteed effect on a player.</rdfs:comment>
    <sourceLocator xml:lang="en">Video Game Document.txt, Types, lines 123-143</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#providesContent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">provides content</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/videogame#Cl_GameExtension"/>
    <rdfs:range rdf:resource="http://www.example.org/videogame#Cl_GameContent"/>
    <qualification xml:lang="en">Expansion packs and downloadable content can provide new content. The domain does not imply that every extension, or every extension subtype, provides content.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Game media, line 91</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_Device">
