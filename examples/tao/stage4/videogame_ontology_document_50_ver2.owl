    <sourceLocator xml:lang="en">Video Game Document.txt, Video game terminology, line 33</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_BackwardCompatibility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Backward compatibility</rdfs:label>
    <rdfs:comment xml:lang="en">A platform capability enabling older games to be played on newer platforms; not a subtype of emulator.</rdfs:comment>
    <qualification xml:lang="en">Typically operates directly through the newer platform hardware and built-in software. This mechanism is typical, not universal.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Backward compatibility, line 85</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#designedFor">
