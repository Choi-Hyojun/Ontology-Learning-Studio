  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_DownloadableContent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Downloadable content</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/videogame#Cl_GameExtension"/>
    <qualification xml:lang="en">Can provide new game content and software patches; nominally available through digital distribution. May be free or used for post-release monetization.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Game media, line 91</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc06c151c573947668238dde3362ab768b10">
