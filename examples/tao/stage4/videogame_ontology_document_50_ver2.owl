  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_CrossRegionRatingAffirmation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cross-region rating affirmation</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/videogame#Cl_ContentRatingProcess"/>
    <rdfs:subClassOf rdf:nodeID="nc06c151c573947668238dde3362ab768b60"/>
    <rdfs:subClassOf rdf:nodeID="nc06c151c573947668238dde3362ab768b61"/>
    <rdfs:subClassOf rdf:nodeID="nc06c151c573947668238dde3362ab768b62"/>
    <rdfs:subClassOf rdf:nodeID="nc06c151c573947668238dde3362ab768b63"/>
    <rdfs:comment xml:lang="en">The IARC-facilitated process that follows a completed provider review and affirms its content rating for other regions.</rdfs:comment>
    <qualification xml:lang="en">The target is another region relative to the completed review. Relative ordering and regional difference are retained as source conditions, without a timeline, scale mapping or fabricated occurrence.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Content rating, line 161</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#hasGenre">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
