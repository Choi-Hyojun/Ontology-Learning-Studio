  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_ACB">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_ContentRatingOrganization"/>
    <rdfs:label xml:lang="en">Australian Classification Board</rdfs:label>
    <rdfs:label xml:lang="en">ACB</rdfs:label>
    <providesRatingsIn rdf:resource="http://www.example.org/videogame#Ind_Australia"/>
    <qualification xml:lang="en">The document reports that ACB ratings are legally enforceable and that games lacking a rating or receiving Refused Classification cannot be imported or purchased digitally in Australia. This is the document's exception to general voluntariness, not independently verified current law.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Content rating, line 155</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc06c151c573947668238dde3362ab768b62">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.example.org/videogame#affirmedForRegion"/>
    <owl:someValuesFrom rdf:resource="http://www.example.org/videogame#Cl_Region"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_Minecraft">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_VideoGame"/>
    <rdfs:label xml:lang="en">Minecraft</rdfs:label>
    <qualification xml:lang="en">Named as an open-world or virtual-sandbox game used in classrooms after release, although not initially developed for education. Classroom use is not treated as educational design intent.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Educational games, line 135</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_HiddenObject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_GameGenre"/>
    <rdfs:label xml:lang="en">Hidden object</rdfs:label>
    <qualification xml:lang="en">Identified among genres often associated with low-intensity casual gameplay; not every game of the genre is asserted to be casual.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Casual games, line 131</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_ClassificationValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Classification value</rdfs:label>
    <rdfs:comment xml:lang="en">A descriptor used in relational classification, not a game instance.</rdfs:comment>
    <sourceLocator xml:lang="en">videogame_tip_document_50_ver2.md, section 2, classification value registry</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc06c151c573947668238dde3362ab768b39">
    <rdf:first rdf:nodeID="nc06c151c573947668238dde3362ab768b37"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_GameMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Game mode</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/videogame#Cl_ClassificationValue"/>
    <rdfs:comment xml:lang="en">A participation classification describing how many players can use a game at the same time. Single-player and multiplayer are the primary categories; zero-player involves very limited interaction, not necessarily no human involvement.</rdfs:comment>
    <sourceLocator xml:lang="en">Video Game Document.txt, Mode, lines 117-119</sourceLocator>
  </rdf:Description>
