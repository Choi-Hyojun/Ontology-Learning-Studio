    <owl:annotatedTarget rdf:resource="http://www.example.org/videogame#Ind_CompetitiveGameplay"/>
    <qualification xml:lang="en">Most multiplayer games are based on competitive gameplay.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, line 117</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_Emotion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_IntendedPlayerResponse"/>
    <rdfs:label xml:lang="en">Emotion</rdfs:label>
    <sourceLocator xml:lang="en">Video Game Document.txt, Art games, line 143</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc06c151c573947668238dde3362ab768b12">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Axiom"/>
    <owl:annotatedSource rdf:resource="http://www.example.org/videogame#Ind_Multiplayer"/>
    <owl:annotatedProperty rdf:resource="http://www.example.org/videogame#hasPossibleGameplayStyle"/>
    <owl:annotatedTarget rdf:resource="http://www.example.org/videogame#Ind_CooperativeGameplay"/>
    <qualification xml:lang="en">Many multiplayer games offer cooperative gameplay; this is an option, not a requirement for every multiplayer game.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, line 117</sourceLocator>
  </rdf:Description>
