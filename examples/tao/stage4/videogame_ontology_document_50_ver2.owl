  <rdf:Description rdf:about="http://www.example.org/videogame#overlaysVisualOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">overlays visual output</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/videogame#Cl_HeadsUpDisplay"/>
    <rdfs:range rdf:resource="http://www.example.org/videogame#Cl_VisualOutput"/>
    <rdfs:comment xml:lang="en">Places the interface atop the rendering of the game, rather than making it a physical display.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#originallyIntendedFor">
