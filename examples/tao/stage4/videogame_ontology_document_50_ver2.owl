  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_AlcoholUse">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_ContentTheme"/>
    <rdfs:label xml:lang="en">Alcohol use</rdfs:label>
    <qualification xml:lang="en">May be identified in content review as a theme that can influence children.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Content rating, line 147</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_PEGI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_ContentRatingSystem"/>
    <rdfs:label xml:lang="en">Pan European Game Information</rdfs:label>
    <rdfs:label xml:lang="en">PEGI</rdfs:label>
    <providesRatingsIn rdf:resource="http://www.example.org/videogame#Ind_UnitedKingdom"/>
    <providesRatingsIn rdf:resource="http://www.example.org/videogame#Ind_EuropeanUnion"/>
    <qualification xml:lang="en">Covers the United Kingdom, most of the European Union and other European countries not enumerated by the document. It is a rating system, not asserted to be a rating organization.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Content rating, line 153</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_FloppyDisc">
