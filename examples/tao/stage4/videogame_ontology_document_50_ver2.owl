  <rdf:Description rdf:about="http://www.example.org/videogame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Document-grounded video game ontology</rdfs:label>
    <dcterms:source xml:lang="en">ontology_instruction.txt; source and modeling priority. fileciteturn0file0L13-L18</dcterms:source>
    <dcterms:source xml:lang="en">videogame_tip_document_50_ver2.md; class registry and implementation policy. fileciteturn0file1L94-L110 fileciteturn0file1L171-L193</dcterms:source>
    <dcterms:source xml:lang="en">Video Game Document.txt; factual source, including named game examples and rating coverage. fileciteturn0file2L131-L143 fileciteturn0file2L151-L161</dcterms:source>
    <rdfs:comment xml:lang="en">OWL 2 DL ontology implementing the supplied TIP. Classes, properties and restrictions follow the TIP; named examples and factual qualifications come from the supplied document. No external background instances or invented game, player, review or rating records are included. Historical, regional and legal statements are document reports, not independently verified current claims. Missing assertions do not establish negation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_Remaster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_VersionForm"/>
    <rdfs:label xml:lang="en">Remaster</rdfs:label>
    <qualification xml:lang="en">Reuses most of the original game's source code and updates art assets, in-game models and levels for modern systems. No percentage, total-code-reuse condition or platform maximum is supplied.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Platform, line 43</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc06c151c573947668238dde3362ab768b21">
