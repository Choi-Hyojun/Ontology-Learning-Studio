    <rdfs:range rdf:resource="http://www.example.org/videogame#Cl_VideoGamePlatform"/>
    <qualification xml:lang="en">Games are typically designed for one or a limited number of platforms; no maximum or exact count is asserted.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Platform, line 43</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_Region">
