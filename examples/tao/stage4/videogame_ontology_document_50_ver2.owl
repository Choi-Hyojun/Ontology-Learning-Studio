  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_HapticTechnology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Haptic technology</rdfs:label>
    <rdfs:comment xml:lang="en">Technology providing tactile sensations, such as shaking a controller in the player's hands.</rdfs:comment>
    <qualification xml:lang="en">Some platforms support this additional feedback; it is commonly built into controllers.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Introduction, line 3; Display and output, line 103</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#mayBoostAttribute">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">may boost attribute</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/videogame#Cl_PowerUp"/>
    <rdfs:range rdf:resource="http://www.example.org/videogame#Cl_AvatarAttribute"/>
    <qualification xml:lang="en">In the described gameplay, collecting a power-up can boost an avatar's innate attributes.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Video game terminology, line 33</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_GrandTheftAutoClone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_GameGenre"/>
