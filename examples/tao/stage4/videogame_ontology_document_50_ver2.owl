    <rdfs:range rdf:resource="http://www.example.org/videogame#Cl_GameGenre"/>
    <qualification xml:lang="en">Generally based on gameplay interaction; horror is a narrative-based exception. More than one genre may apply.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Genre, lines 111-113</sourceLocator>
  </rdf:Description>
