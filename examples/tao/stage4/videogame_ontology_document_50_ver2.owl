    <rdfs:label xml:lang="en">Avatar</rdfs:label>
    <rdfs:comment xml:lang="en">The in-game representation controlled by a player in the described gameplay.</rdfs:comment>
    <sourceLocator xml:lang="en">Video Game Document.txt, Video game terminology, line 33</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_AugmentedRealityGameplay">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Augmented reality gameplay</rdfs:label>
    <sourceLocator xml:lang="en">Video Game Document.txt, Mobile game, line 69</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_GameOverScreen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Game-over screen</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/videogame#Cl_OnScreenUserInterface"/>
    <sourceLocator xml:lang="en">Video Game Document.txt, Video game terminology, line 33</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_ArtGame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Art game</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/videogame#Cl_VideoGame"/>
    <rdfs:subClassOf rdf:nodeID="nc06c151c573947668238dde3362ab768b58"/>
    <rdfs:subClassOf rdf:nodeID="nc06c151c573947668238dde3362ab768b59"/>
    <rdfs:comment xml:lang="en">Also called an arthouse game; designed to communicate a story or message through the medium as a work of art.</rdfs:comment>
    <qualification xml:lang="en">Emotion and empathy are intended responses, not guaranteed outcomes. Art games may lack a winning condition, allow exploration, and are mostly indie games based on personal experiences or stories.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Art games, line 143</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_GlobalPositioningInformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Global positioning information</rdfs:label>
    <rdfs:comment xml:lang="en">Information available from a mobile device, not a device or hardware component.</rdfs:comment>
    <qualification xml:lang="en">May support augmented reality gameplay; no mobile device is required to provide it.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Mobile game, line 69</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Cl_SeriousGame">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Serious game</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/videogame#Cl_VideoGame"/>
    <rdfs:subClassOf rdf:nodeID="nc06c151c573947668238dde3362ab768b57"/>
    <rdfs:comment xml:lang="en">Game design reinforces a purpose beyond entertainment.</rdfs:comment>
    <qualification xml:lang="en">Other purposes may augment, overshadow or eliminate the entertainment factor. Serious games need not lack entertainment and are not disjoint from other purpose-based game types.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Serious games, line 139</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#enablesExecutionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">enables execution of</rdfs:label>
    <rdfs:domain rdf:nodeID="nc06c151c573947668238dde3362ab768b4"/>
    <rdfs:range rdf:resource="http://www.example.org/videogame#Cl_VideoGame"/>
    <rdfs:comment xml:lang="en">Enables execution of games from another or older system, preserving the distinction between emulation software and backward-compatibility capability.</rdfs:comment>
    <sourceLocator xml:lang="en">Video Game Document.txt, Emulation, line 81; Backward compatibility, line 85</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_PlayStation2Platform">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_VideoGamePlatform"/>
    <rdfs:label xml:lang="en">PlayStation 2</rdfs:label>
    <hasBackwardCompatibility rdf:resource="http://www.example.org/videogame#Ind_PlayStation2BackwardCompatibility"/>
    <rdfs:comment xml:lang="en">The source describes playing past-generation PlayStation games by inserting original game media into the newer console.</rdfs:comment>
    <sourceLocator xml:lang="en">Video Game Document.txt, Backward compatibility, line 85</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_Doom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_FirstPersonShooter"/>
    <rdfs:label xml:lang="en">Doom</rdfs:label>
    <rdfs:comment xml:lang="en">The document explains that first-person shooters were initially called Doom clones after this 1993 game.</rdfs:comment>
    <sourceLocator xml:lang="en">Video Game Document.txt, Genre, line 113</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_EaseOfAccessibility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_DesignCharacteristic"/>
    <rdfs:label xml:lang="en">Ease of accessibility</rdfs:label>
    <sourceLocator xml:lang="en">Video Game Document.txt, Casual games, line 131</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_ZeroPlayer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_GameMode"/>
    <rdfs:label xml:lang="en">Zero-player</rdfs:label>
    <qualification xml:lang="en">A small number of games have very limited player interaction. The player may establish a starting state and then passively observe the game proceeding on its own. These are most commonly simulations, exemplified by many computerized simulations of Conway's Game of Life. This does not mean zero human involvement.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Mode, line 119</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#Ind_Sega">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/videogame#Cl_Party"/>
    <rdfs:label xml:lang="en">Sega</rdfs:label>
    <rdfs:comment xml:lang="en">The document describes Sega as a console-industry company and reports that it exited the console space by the 2000s.</rdfs:comment>
    <sourceLocator xml:lang="en">Video Game Document.txt, Introduction, line 7; Platform, line 43; Backward compatibility, line 85</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/videogame#usesMinimumAgeIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">uses minimum-age identifier</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/videogame#Cl_ContentRatingSystem"/>
    <rdfs:range rdf:resource="http://www.example.org/videogame#Cl_MinimumAgeIdentifier"/>
    <qualification xml:lang="en">Nearly all systems use a primary identifier based on minimum age; no universal restriction or numeric age is asserted.</qualification>
    <sourceLocator xml:lang="en">Video Game Document.txt, Content rating, line 147</sourceLocator>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nc06c151c573947668238dde3362ab768b20">
