@prefix : <http://www.example.org/videogame#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://www.example.org/videogame> a owl:Ontology ;
    rdfs:label "Document-grounded video game ontology"@en ;
    dcterms:source "ontology_instruction.txt; source and modeling priority. fileciteturn0file0L13-L18"@en,
        "videogame_tip_document_50_ver2.md; class registry and implementation policy. fileciteturn0file1L94-L110 fileciteturn0file1L171-L193"@en,
        "Video Game Document.txt; factual source, including named game examples and rating coverage. fileciteturn0file2L131-L143 fileciteturn0file2L151-L161"@en ;
    rdfs:comment "OWL 2 DL ontology implementing the supplied TIP. Classes, properties and restrictions follow the TIP; named examples and factual qualifications come from the supplied document. No external background instances or invented game, player, review or rating records are included. Historical, regional and legal statements are document reports, not independently verified current claims. Missing assertions do not establish negation."@en .

dcterms:source a owl:AnnotationProperty .

:sourceLocator a owl:AnnotationProperty ;
    rdfs:label "source locator"@en ;
    rdfs:comment "Identifies a supplied file and its section or line range supporting the annotated statement."@en .

:qualification a owl:AnnotationProperty ;
    rdfs:label "qualification"@en ;
    rdfs:comment "Preserves scoped typicality, possibility, prevalence, relative extent, design intent or source-report limitations without asserting a universal logical rule."@en .

:condition a owl:AnnotationProperty ;
    rdfs:label "condition"@en ;
    rdfs:comment "Preserves a source-described condition; the text is not an executable state transition or an OWL cardinality constraint."@en .

:Cl_ElectronicGame a owl:Class ;
    rdfs:label "Electronic game"@en ;
    rdfs:comment "The broader electronic-game category includes video games and electronic games without video output."@en ;
    :sourceLocator "Video Game Document.txt, Terminology, lines 13-17"@en .

:Cl_VideoGame a owl:Class ;
    rdfs:label "Video game"@en ;
    rdfs:subClassOf :Cl_ElectronicGame ;
    rdfs:comment "An electronic game with player interaction affecting its visual output."@en ;
    :qualification "A winning condition is not necessary when a player can interact with the game world. Most games have levels, but levels are not universally required. Most video games are intended for entertainment."@en ;
    :sourceLocator "Video Game Document.txt, Definition, lines 25-27; Video game terminology, line 33; Types, line 123"@en .

:Cl_ShooterGame a owl:Class ;
    rdfs:label "Shooter game"@en ;
    rdfs:subClassOf :Cl_VideoGame ;
    rdfs:comment "A gameplay-based game class with first-person and third-person shooter subclasses; it is not also a genre-descriptor individual."@en ;
    :sourceLocator "Video Game Document.txt, Genre, lines 111-113"@en .

:Cl_FirstPersonShooter a owl:Class ;
    rdfs:label "First-person shooter"@en ;
    rdfs:subClassOf :Cl_ShooterGame ;
    :sourceLocator "Video Game Document.txt, Genre, line 113"@en .

:Cl_ThirdPersonShooter a owl:Class ;
    rdfs:label "Third-person shooter"@en ;
    rdfs:subClassOf :Cl_ShooterGame ;
    :sourceLocator "Video Game Document.txt, Genre, line 113"@en .

:Cl_CoreGame a owl:Class ;
    rdfs:label "Core game"@en ;
    rdfs:subClassOf :Cl_VideoGame ;
    :qualification "Also called hard-core games. Typically require a fair amount of time to learn and master and are most appealing to gamers rather than a broader audience. No numeric learning or mastery duration is specified."@en ;
    :sourceLocator "Video Game Document.txt, Core games, line 127"@en .

:Cl_CasualGame a owl:Class ;
    rdfs:label "Casual game"@en ;
    rdfs:subClassOf :Cl_VideoGame ;
    :qualification "Designed for a mass-market audience. Frequently support entering and leaving play on demand; numerous browser and mobile games are casual. Often use low-intensity gameplay and may use social-network mechanics."@en ;
    :sourceLocator "Video Game Document.txt, Casual games, line 131"@en .

:Cl_SeriousGame a owl:Class ;
    rdfs:label "Serious game"@en ;
    rdfs:subClassOf :Cl_VideoGame ;
    rdfs:comment "Game design reinforces a purpose beyond entertainment."@en ;
    :qualification "Other purposes may augment, overshadow or eliminate the entertainment factor. Serious games need not lack entertainment and are not disjoint from other purpose-based game types."@en ;
    :sourceLocator "Video Game Document.txt, Serious games, line 139"@en .

:Cl_ArtGame a owl:Class ;
    rdfs:label "Art game"@en ;
    rdfs:subClassOf :Cl_VideoGame ;
    rdfs:comment "Also called an arthouse game; designed to communicate a story or message through the medium as a work of art."@en ;
    :qualification "Emotion and empathy are intended responses, not guaranteed outcomes. Art games may lack a winning condition, allow exploration, and are mostly indie games based on personal experiences or stories."@en ;
    :sourceLocator "Video Game Document.txt, Art games, line 143"@en .

:Cl_EducationalGame a owl:Class ;
    rdfs:label "Educational game"@en ;
    rdfs:subClassOf :Cl_SeriousGame ;
    rdfs:comment "Uses interactivity and game-design elements for education. The document names The Oregon Trail and the Carmen Sandiego series as examples."@en ;
    :sourceLocator "Video Game Document.txt, Educational games, line 135; Serious games, line 139"@en .

:Cl_EdutainmentGame a owl:Class ;
    rdfs:label "Edutainment game"@en ;
    rdfs:subClassOf :Cl_EducationalGame ;
    :qualification "Tends to emphasize entertainment and rote learning and is described as unlikely to engage critical thinking."@en ;
    :sourceLocator "Video Game Document.txt, Educational games, line 135"@en .

:Cl_EducationalVideoGame a owl:Class ;
    rdfs:label "Educational video game"@en ;
    rdfs:subClassOf :Cl_EducationalGame ;
    rdfs:comment "The narrower educational branch geared toward problem solving through motivation and positive reinforcement while downplaying entertainment, rather than a synonym for every educational game."@en ;
    :sourceLocator "Video Game Document.txt, Educational games, line 135"@en .

:Cl_FitnessGame a owl:Class ;
    rdfs:label "Fitness game"@en ;
    rdfs:subClassOf :Cl_SeriousGame ;
    rdfs:comment "Incorporates significant physical exercise to help keep the player fit."@en ;
    :sourceLocator "Video Game Document.txt, Serious games, line 139"@en .

:Cl_SimulatorGame a owl:Class ;
    rdfs:label "Simulator game"@en ;
    rdfs:subClassOf :Cl_SeriousGame ;
    rdfs:comment "Serious-game simulation, exemplified by flight simulation for piloting aircraft."@en ;
    :sourceLocator "Video Game Document.txt, Serious games, line 139"@en .

:Cl_Advergame a owl:Class ;
    rdfs:label "Advergame"@en ;
    rdfs:subClassOf :Cl_SeriousGame ;
    rdfs:comment "A game built around advertising a product."@en ;
    :sourceLocator "Video Game Document.txt, Serious games, line 139"@en .

:Cl_Newsgame a owl:Class ;
    rdfs:label "Newsgame"@en ;
    rdfs:subClassOf :Cl_SeriousGame ;
    rdfs:comment "A game aimed at conveying a specific advocacy message."@en ;
    :sourceLocator "Video Game Document.txt, Serious games, line 139"@en .

:Cl_PlayerInteraction a owl:Class ;
    rdfs:label "Player interaction"@en ;
    rdfs:comment "Interaction between a player and a game, including limited setup interaction. Only the defining interaction is required to affect visual output; not every action must do so."@en ;
    :sourceLocator "Video Game Document.txt, Definition, line 25; Mode, line 119"@en .

:Cl_GameWorld a owl:Class ;
    rdfs:label "Game world"@en ;
    rdfs:comment "The world with which a player can interact within a game."@en ;
    :sourceLocator "Video Game Document.txt, Definition, line 27"@en .

:Cl_WinningCondition a owl:Class ;
    rdfs:label "Winning condition"@en ;
    :qualification "Most video games feature a victory condition, such as a scoring mechanism or final boss fight, but a winning condition is not necessary for video-game status."@en ;
    :sourceLocator "Video Game Document.txt, Definition, line 27"@en .

:Cl_Avatar a owl:Class ;
    rdfs:label "Avatar"@en ;
    rdfs:comment "The in-game representation controlled by a player in the described gameplay."@en ;
    :sourceLocator "Video Game Document.txt, Video game terminology, line 33"@en .

:Cl_AvatarAttribute a owl:Class ;
    rdfs:label "Avatar attribute"@en ;
    rdfs:comment "An innate attribute of an avatar that a power-up may boost."@en ;
    :sourceLocator "Video Game Document.txt, Video game terminology, line 33"@en .

:Cl_Health a owl:Class ;
    rdfs:label "Health"@en ;
    rdfs:subClassOf :Cl_AvatarAttribute ;
    rdfs:comment "An avatar attribute depleted by damage in the described gameplay. A zero-health loss threshold is not an assertion about any actual avatar health value."@en ;
    :sourceLocator "Video Game Document.txt, Video game terminology, line 33"@en .

:Cl_PowerUp a owl:Class ;
    rdfs:label "Power-up"@en ;
    :sourceLocator "Video Game Document.txt, Video game terminology, line 33"@en .

:Cl_Damage a owl:Class ;
    rdfs:label "Damage"@en ;
    :sourceLocator "Video Game Document.txt, Video game terminology, line 33"@en .

:Cl_Life a owl:Class ;
    rdfs:label "Life"@en ;
    rdfs:comment "A countable allowance that a player can lose or gain in the described gameplay. An extra life is also called a 1-UP."@en ;
    :sourceLocator "Video Game Document.txt, Video game terminology, line 33"@en .

:Cl_SavedGame a owl:Class ;
    rdfs:label "Saved game"@en ;
    rdfs:comment "A recorded game state on storage media, or a passage that can be written down and re-entered, supporting a restart."@en ;
    :qualification "Available in some games, including through intermediate save points; availability is not required for every game."@en ;
    :sourceLocator "Video Game Document.txt, Video game terminology, line 33"@en .

:Cl_GameplayInformation a owl:Class ;
    rdfs:label "Gameplay information"@en ;
    rdfs:comment "Information about gameplay relayed to the player through an on-screen interface."@en ;
    :sourceLocator "Video Game Document.txt, Video game terminology, line 33"@en .

:Cl_OnScreenUserInterface a owl:Class ;
    rdfs:label "On-screen user interface"@en ;
    rdfs:comment "An interface presented on screen, rather than the physical display device."@en ;
    :sourceLocator "videogame_tip_document_50_ver2.md, section 2, gameplay class registry"@en .

:Cl_HeadsUpDisplay a owl:Class ;
    rdfs:label "Heads-up display"@en ;
    rdfs:subClassOf :Cl_OnScreenUserInterface ;
    rdfs:comment "An on-screen user interface that presents gameplay information atop the rendered game."@en ;
    :sourceLocator "Video Game Document.txt, Video game terminology, line 33"@en .

:Cl_GameOverScreen a owl:Class ;
    rdfs:label "Game-over screen"@en ;
    rdfs:subClassOf :Cl_OnScreenUserInterface ;
    :sourceLocator "Video Game Document.txt, Video game terminology, line 33"@en .

:Cl_GameContent a owl:Class ;
    rdfs:label "Game content"@en ;
    rdfs:comment "Reusable parent for art assets, in-game models and levels."@en ;
    :sourceLocator "videogame_tip_document_50_ver2.md, section 2, content class registry"@en .

:Cl_ArtAsset a owl:Class ;
    rdfs:label "Art asset"@en ;
    rdfs:subClassOf :Cl_GameContent ;
    :sourceLocator "Video Game Document.txt, Platform, line 43"@en .

:Cl_GameModel a owl:Class ;
    rdfs:label "In-game model"@en ;
    rdfs:subClassOf :Cl_GameContent ;
    :sourceLocator "Video Game Document.txt, Platform, line 43"@en .

:Cl_Level a owl:Class ;
    rdfs:label "Level"@en ;
    rdfs:subClassOf :Cl_GameContent ;
    :sourceLocator "Video Game Document.txt, Platform, line 43"@en .

:Cl_SourceCode a owl:Class ;
    rdfs:label "Source code"@en ;
    :sourceLocator "Video Game Document.txt, Platform, line 43"@en .

:Cl_VisualOutput a owl:Class ;
    rdfs:label "Visual output"@en ;
    rdfs:comment "Visual output produced by a game, distinct from the device displaying it. Output forms can overlap."@en ;
    :sourceLocator "Video Game Document.txt, Display and output, line 99"@en .

:Cl_HumanAction a owl:Class ;
    rdfs:label "Human action"@en ;
    :sourceLocator "Video Game Document.txt, Input device, line 95"@en .

:Cl_GameInput a owl:Class ;
    rdfs:label "Game input"@en ;
    :sourceLocator "Video Game Document.txt, Input device, line 95"@en .

:Cl_GlobalPositioningInformation a owl:Class ;
    rdfs:label "Global positioning information"@en ;
    rdfs:comment "Information available from a mobile device, not a device or hardware component."@en ;
    :qualification "May support augmented reality gameplay; no mobile device is required to provide it."@en ;
    :sourceLocator "Video Game Document.txt, Mobile game, line 69"@en .

:Cl_AugmentedRealityGameplay a owl:Class ;
    rdfs:label "Augmented reality gameplay"@en ;
    :sourceLocator "Video Game Document.txt, Mobile game, line 69"@en .

:Cl_MotionTracking a owl:Class ;
    rdfs:label "Motion tracking"@en ;
    :sourceLocator "Video Game Document.txt, Virtual reality, line 77"@en .

:Cl_HapticTechnology a owl:Class ;
    rdfs:label "Haptic technology"@en ;
    rdfs:comment "Technology providing tactile sensations, such as shaking a controller in the player's hands."@en ;
    :qualification "Some platforms support this additional feedback; it is commonly built into controllers."@en ;
    :sourceLocator "Video Game Document.txt, Introduction, line 3; Display and output, line 103"@en .

:Cl_TactileFeedback a owl:Class ;
    rdfs:label "Tactile feedback"@en ;
    :sourceLocator "Video Game Document.txt, Introduction, line 3; Display and output, line 103"@en .

:Cl_VideoGamePlatform a owl:Class ;
    rdfs:label "Video game platform"@en ;
    rdfs:comment "A combination of electronic components or computer hardware and associated software required to operate a game."@en ;
    :sourceLocator "Video Game Document.txt, Platform, line 43"@en .

:Cl_VideoGamePlatform rdfs:label "System"@en .

:Cl_PlatformComponent a owl:Class ;
    rdfs:label "Platform component"@en ;
    rdfs:comment "Reusable parent for the hardware and software components of a platform."@en ;
    :sourceLocator "videogame_tip_document_50_ver2.md, section 2, platform component class registry"@en .

:Cl_Hardware a owl:Class ;
    rdfs:label "Hardware"@en ;
    rdfs:subClassOf :Cl_PlatformComponent .

:Cl_Software a owl:Class ;
    rdfs:label "Software"@en ;
    rdfs:subClassOf :Cl_PlatformComponent .

:Cl_Device a owl:Class ;
    rdfs:label "Device"@en ;
    rdfs:subClassOf :Cl_Hardware ;
    rdfs:comment "Physical equipment used in platforms, input or output."@en ;
    :sourceLocator "videogame_tip_document_50_ver2.md, section 2, device class registry"@en .

:Cl_RemoteHardware a owl:Class ;
    rdfs:label "Remote hardware"@en ;
    rdfs:subClassOf :Cl_Hardware ;
    :sourceLocator "Video Game Document.txt, Cloud gaming, line 73"@en .

:Cl_Emulator a owl:Class ;
    rdfs:label "Emulator"@en ;
    rdfs:subClassOf :Cl_Software ;
    rdfs:comment "Software enabling games from a different system to run by simulating the original hardware in a virtual machine on a host platform."@en ;
    :sourceLocator "Video Game Document.txt, Emulation, line 81"@en .

:Cl_SoftwarePatch a owl:Class ;
    rdfs:label "Software patch"@en ;
    rdfs:subClassOf :Cl_Software ;
    :sourceLocator "Video Game Document.txt, Game media, line 91"@en .

:Cl_VirtualMachine a owl:Class ;
    rdfs:label "Virtual machine"@en ;
    rdfs:comment "The execution environment used for hardware simulation by an emulator and running on a host platform."@en ;
    :sourceLocator "Video Game Document.txt, Emulation, line 81"@en .

:Cl_BackwardCompatibility a owl:Class ;
    rdfs:label "Backward compatibility"@en ;
    rdfs:comment "A platform capability enabling older games to be played on newer platforms; not a subtype of emulator."@en ;
    :qualification "Typically operates directly through the newer platform hardware and built-in software. This mechanism is typical, not universal."@en ;
    :sourceLocator "Video Game Document.txt, Backward compatibility, line 85"@en .

:Cl_Console a owl:Class ;
    rdfs:label "Console"@en ;
    rdfs:subClassOf :Cl_Device ;
    :sourceLocator "Video Game Document.txt, Home console, line 53"@en .

:Cl_HandheldGameConsole a owl:Class ;
    rdfs:label "Handheld game console"@en ;
    rdfs:subClassOf :Cl_Device ;
    :sourceLocator "Video Game Document.txt, Handheld console, line 57"@en .

:Cl_MobileDevice a owl:Class ;
    rdfs:label "Mobile device"@en ;
    rdfs:subClassOf :Cl_Device ;
