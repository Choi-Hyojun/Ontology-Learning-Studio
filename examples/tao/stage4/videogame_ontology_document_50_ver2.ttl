    :sourceLocator "Video Game Document.txt, Casual games, line 131"@en .

:Cl_GamePurpose a owl:Class ;
    rdfs:label "Game purpose"@en ;
    rdfs:comment "A purpose motivating game design, rather than a guaranteed effect on a player."@en ;
    :sourceLocator "Video Game Document.txt, Types, lines 123-143"@en .

:Cl_IntendedPlayerResponse a owl:Class ;
    rdfs:label "Intended player response"@en ;
    rdfs:comment "A response intended by game design; it need not actually occur."@en ;
    :sourceLocator "Video Game Document.txt, Art games, line 143"@en .

:Cl_Party a owl:Class ;
    rdfs:label "Party"@en ;
    rdfs:comment "A person or organization filling a contextual player, developer, publisher, distributor, retailer, marketer, manufacturer, provider or consumer role. A party may fill more than one role."@en ;
    :sourceLocator "Video Game Document.txt, Introduction, line 9; Content rating, line 161"@en .

:Cl_ContentRatingOrganization a owl:Class ;
    rdfs:label "Content rating organization"@en ;
    rdfs:subClassOf :Cl_Party ;
    rdfs:comment "An organization providing content ratings, distinct from a rating scheme and an assigned rating."@en ;
    :sourceLocator "Video Game Document.txt, Content rating, lines 151-159"@en .

:Cl_ContentRating a owl:Class ;
    rdfs:label "Content rating"@en ;
    rdfs:comment "An assigned classification of game content, distinct from the system and organization used to produce it."@en ;
    :qualification "The document identifies target-age appropriateness, with most content review considering violence and sexual content; drug use, alcohol use and gambling may also influence ratings."@en ;
    :sourceLocator "Video Game Document.txt, Content rating, line 147"@en .

:Cl_ContentRatingSystem a owl:Class ;
    rdfs:label "Content rating system"@en ;
    rdfs:comment "A rating scheme, distinct from an organization or an assigned content rating."@en ;
    :qualification "Nearly all systems use a primary minimum-age identifier and additional specific-content descriptors. Systems are generally voluntary and upheld by vendor practices; regulations vary by country. The document reports penalties or fines for publisher misuse and an ACB legal-enforcement exception. These are source reports, not independently verified current rules."@en ;
    :sourceLocator "Video Game Document.txt, Content rating, lines 147-155"@en .

:Cl_MinimumAgeIdentifier a owl:Class ;
    rdfs:label "Minimum-age identifier"@en ;
    rdfs:comment "A lexical primary identifier based on minimum age. No specific rating-age values or scale mappings are populated."@en ;
    :sourceLocator "Video Game Document.txt, Content rating, line 147"@en .

:Cl_ContentDescriptor a owl:Class ;
    rdfs:label "Content descriptor"@en ;
    rdfs:comment "Identifies specific content that players and parents should be aware of."@en ;
    :sourceLocator "Video Game Document.txt, Content rating, line 147"@en .

:Cl_ContentTheme a owl:Class ;
    rdfs:label "Content theme"@en ;
    :sourceLocator "Video Game Document.txt, Content rating, line 147"@en .

:Cl_Region a owl:Class ;
    rdfs:label "Region"@en ;
    rdfs:comment "A geographical jurisdiction or grouping within which ratings are provided; a coverage relation does not assert coverage of every place in the region."@en ;
    :sourceLocator "videogame_tip_document_50_ver2.md, section 2, parties and ratings registry"@en .

:Cl_ContentRatingProcess a owl:Class ;
    rdfs:label "Content rating process"@en ;
    rdfs:comment "Parent for the source-described rating review and subsequent cross-region affirmation, rather than an event model for every domain relationship."@en ;
    :sourceLocator "Video Game Document.txt, Content rating, line 161"@en .

:Cl_ContentRatingReview a owl:Class ;
    rdfs:label "Content rating review"@en ;
    rdfs:subClassOf :Cl_ContentRatingProcess ;
    rdfs:comment "Scopes a publisher submission, reviewing provider and content rating to a single review. No actual review occurrence is supplied."@en ;
    :qualification "Completing a review with one provider is sufficient for the described IARC route; this is not an exact-one-provider constraint."@en ;
    :sourceLocator "Video Game Document.txt, Content rating, line 161"@en .

:Cl_CrossRegionRatingAffirmation a owl:Class ;
    rdfs:label "Cross-region rating affirmation"@en ;
    rdfs:subClassOf :Cl_ContentRatingProcess ;
    rdfs:comment "The IARC-facilitated process that follows a completed provider review and affirms its content rating for other regions."@en ;
    :qualification "The target is another region relative to the completed review. Relative ordering and regional difference are retained as source conditions, without a timeline, scale mapping or fabricated occurrence."@en ;
    :sourceLocator "Video Game Document.txt, Content rating, line 161"@en .

