:Ind_PlayStation2BackwardCompatibility a
    [ a owl:Restriction ; owl:onProperty :enablesExecutionOf ;
      owl:someValuesFrom [ a owl:Class ; owl:intersectionOf (
          :Cl_VideoGame
          [ a owl:Restriction ; owl:onProperty :originallyIntendedFor ; owl:hasValue :Ind_PlayStationPlatform ]
      ) ] ] .

:Ind_WiiBackwardCompatibility a
    [ a owl:Restriction ; owl:onProperty :enablesExecutionOf ;
      owl:someValuesFrom [ a owl:Class ; owl:intersectionOf (
          :Cl_VideoGame
          [ a owl:Restriction ; owl:onProperty :originallyIntendedFor ; owl:hasValue :Ind_GameCubePlatform ]
      ) ] ] .

