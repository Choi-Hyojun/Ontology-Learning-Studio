    rdfs:domain :Cl_CrossRegionRatingAffirmation ;
    rdfs:range :Cl_ContentRating ;
    rdfs:subPropertyOf :concernsRating .

:affirmedForRegion a owl:ObjectProperty ;
    rdfs:label "affirmed for region"@en ;
    rdfs:domain :Cl_CrossRegionRatingAffirmation ;
    rdfs:range :Cl_Region ;
    :qualification "Another region relative to the completed review; no exhaustive list of regions or rating-scale equivalence is asserted."@en ;
    :sourceLocator "Video Game Document.txt, Content rating, line 161"@en .

:facilitatedBy a owl:ObjectProperty ;
    rdfs:label "facilitated by"@en ;
    rdfs:domain :Cl_CrossRegionRatingAffirmation ;
    rdfs:range :Cl_Party ;
    rdfs:comment "Identifies the facilitator, not necessarily a rating-assigning organization."@en .

:healthValue a owl:DatatypeProperty ;
    rdfs:label "health value"@en ;
    rdfs:domain :Cl_Health ;
    rdfs:range xsd:decimal ;
    rdfs:comment "Records a supplied health value. The zero-health loss condition does not provide an actual avatar health measurement."@en ;
    :sourceLocator "videogame_tip_document_50_ver2.md, section 2, data properties; Video Game Document.txt, line 33"@en .

:simultaneousPlayerCount a owl:DatatypeProperty ;
    rdfs:label "simultaneous player count"@en ;
    rdfs:domain :Cl_GameMode ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:comment "An explicitly supplied simultaneous-player count for a mode value. Only Single-Player is assigned the value 1; no exact multiplayer count or zero-human-involvement count is asserted."@en ;
    :sourceLocator "videogame_tip_document_50_ver2.md, section 2, data properties; Video Game Document.txt, Mode, lines 117-119"@en .

:Ind_ArcadeVideoGame a owl:NamedIndividual, :Cl_PlatformCategory ;
    rdfs:label "Arcade video game"@en ;
    :qualification "Generally played on specialized equipment in a large coin-operated cabinet with a built-in console, controls, screen, amplifier and speakers. Typically dedicated to one game, but some offer a choice of games."@en ;
    :sourceLocator "Video Game Document.txt, Introduction, line 5; Arcade video game, line 61"@en .

:Ind_ConsoleGame a owl:NamedIndividual, :Cl_PlatformCategory ;
    rdfs:label "Console game"@en ;
    rdfs:comment "The home-console grouping; a home console connects to a television or composite video monitor and offers a dedicated hardware environment."@en ;
    :qualification "Often comes with a specific game controller. The source describes restrictions on which platforms' games normally run, rather than an ontology-wide exclusion rule."@en ;
    :sourceLocator "Video Game Document.txt, Home console, line 53"@en .

:Ind_ComputerGame a owl:NamedIndividual, :Cl_PlatformCategory ;
    rdfs:label "Computer game"@en ;
    rdfs:comment "The PC/platform grouping, not the unrestricted lexical synonym for all video games."@en ;
    :qualification "Personal computers are not dedicated game platforms; hardware differences can affect execution. The source also describes mainframe and shared-system gaming."@en ;
    :sourceLocator "Video Game Document.txt, Terminology, line 15; PC games, line 49"@en .

:Ind_MobileGame a owl:NamedIndividual, :Cl_PlatformCategory ;
    rdfs:label "Mobile game"@en ;
    :qualification "Mobile devices such as smartphones and tablets may use accelerometers, global positioning information and cameras for augmented reality gameplay; those features are optional."@en ;
    :sourceLocator "Video Game Document.txt, Introduction, line 5; Mobile game, line 69"@en .

:Ind_VirtualRealityGame a owl:NamedIndividual, :Cl_PlatformCategory ;
    rdfs:label "Virtual reality game"@en ;
    :qualification "Generally requires a head-mounted unit providing stereoscopic screens and motion tracking. Some systems include hand controls; systems generally use a separate computer, console or other processing device."@en ;
    :sourceLocator "Video Game Document.txt, Virtual reality, line 77"@en .

:Ind_AugmentedRealityGame a owl:NamedIndividual, :Cl_PlatformCategory ;
    rdfs:label "Augmented reality game"@en ;
    :sourceLocator "Video Game Document.txt, Introduction, line 5; Mobile game, line 69"@en .

:Ind_CloudGame a owl:NamedIndividual, :Cl_PlatformCategory ;
    rdfs:label "Cloud game"@en ;
    rdfs:comment "Computed and rendered on remote hardware supplied by the cloud gaming provider."@en ;
    :qualification "The source describes a minimal local device connected to a display and good Internet connectivity, with predictive methods to reduce input-to-output network latency."@en ;
    :sourceLocator "Video Game Document.txt, Cloud gaming, line 73"@en .

:Ind_Port a owl:NamedIndividual, :Cl_VersionForm ;
    rdfs:label "Port"@en ;
    rdfs:label "Conversion"@en ;
    rdfs:comment "A game developed for an alternative platform to the one originally intended."@en ;
    :qualification "Alternative-platform status requires positive source evidence. A port may also be a remaster or remake; the forms are not exclusive."@en ;
    :sourceLocator "Video Game Document.txt, Platform, line 43"@en .

:Ind_Remaster a owl:NamedIndividual, :Cl_VersionForm ;
    rdfs:label "Remaster"@en ;
    :qualification "Reuses most of the original game's source code and updates art assets, in-game models and levels for modern systems. No percentage, total-code-reuse condition or platform maximum is supplied."@en ;
    :sourceLocator "Video Game Document.txt, Platform, line 43"@en .

:Ind_Remake a owl:NamedIndividual, :Cl_VersionForm ;
    rdfs:label "Remake"@en ;
    :qualification "Includes asset improvements and significant reworking of the original game, possibly from scratch. Starting from scratch is possible, not mandatory; a remake is not required to avoid source-code reuse."@en ;
    :sourceLocator "Video Game Document.txt, Platform, line 43"@en .

:Ind_SinglePlayer a owl:NamedIndividual, :Cl_GameMode ;
    rdfs:label "Single-player"@en ;
    :simultaneousPlayerCount "1"^^xsd:nonNegativeInteger ;
    :sourceLocator "Video Game Document.txt, Mode, line 117; videogame_tip_document_50_ver2.md, section 2, data properties"@en .

:Ind_Multiplayer a owl:NamedIndividual, :Cl_GameMode ;
    rdfs:label "Multiplayer"@en ;
    :allowsPlayArrangement :Ind_SameDevice, :Ind_SeparateDevicesLocalNetwork, :Ind_SeparateDevicesInternet ;
    :hasPossibleGameplayStyle :Ind_CompetitiveGameplay, :Ind_CooperativeGameplay, :Ind_TeamBasedGameplay, :Ind_AsymmetricGameplay ;
    :qualification "Most multiplayer games are based on competitive gameplay; many offer cooperative and team-based options as well as asymmetric gameplay. The arrangements and styles are category options, not obligations for each multiplayer game. The source describes MMOs supporting hundreds of simultaneous players without giving an exact multiplayer count."@en ;
    :sourceLocator "Video Game Document.txt, Mode, line 117"@en .

:Ind_ZeroPlayer a owl:NamedIndividual, :Cl_GameMode ;
    rdfs:label "Zero-player"@en ;
    :qualification "A small number of games have very limited player interaction. The player may establish a starting state and then passively observe the game proceeding on its own. These are most commonly simulations, exemplified by many computerized simulations of Conway's Game of Life. This does not mean zero human involvement."@en ;
    :sourceLocator "Video Game Document.txt, Mode, line 119"@en .

