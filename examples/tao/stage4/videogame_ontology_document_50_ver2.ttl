:Cl_VideoGame rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :requiresPlatform ; owl:someValuesFrom :Cl_VideoGamePlatform ],
    [ a owl:Restriction ; owl:onProperty :hasDefiningInteraction ;
      owl:someValuesFrom [ a owl:Class ; owl:intersectionOf (
          :Cl_PlayerInteraction
          [ a owl:Restriction ; owl:onProperty :affectsVisualOutput ; owl:someValuesFrom :Cl_VisualOutput ]
      ) ] ] .

:producesVisualOutput owl:propertyChainAxiom ( :hasDefiningInteraction :affectsVisualOutput ) .

:Cl_VideoGamePlatform rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :hasComponent ; owl:someValuesFrom :Cl_Hardware ],
    [ a owl:Restriction ; owl:onProperty :hasComponent ; owl:someValuesFrom :Cl_Software ] .

:Cl_HandheldGameConsole rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :hasDevicePart ; owl:someValuesFrom :Cl_Console ],
    [ a owl:Restriction ; owl:onProperty :hasDevicePart ; owl:someValuesFrom :Cl_BuiltInScreen ],
    [ a owl:Restriction ; owl:onProperty :hasDevicePart ; owl:someValuesFrom :Cl_Speaker ],
    [ a owl:Restriction ; owl:onProperty :hasDevicePart ; owl:someValuesFrom :Cl_GameController ] .

:Cl_HeadMountedUnit rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :hasDevicePart ; owl:someValuesFrom :Cl_StereoscopicScreen ],
    [ a owl:Restriction ; owl:onProperty :providesMotionTracking ; owl:someValuesFrom :Cl_MotionTracking ] .

[ a owl:Class ; owl:intersectionOf (
    :Cl_VideoGame
    [ a owl:Restriction ; owl:onProperty :hasPlatformCategory ; owl:hasValue :Ind_CloudGame ]
) ] rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :computedAndRenderedOn ;
      owl:someValuesFrom [ a owl:Class ; owl:intersectionOf (
          :Cl_RemoteHardware
          [ a owl:Restriction ; owl:onProperty :providedBy ; owl:someValuesFrom :Cl_Party ]
      ) ] ] .

[ a owl:Class ; owl:intersectionOf (
    :Cl_VideoGame
    [ a owl:Restriction ; owl:onProperty :hasVersionForm ; owl:hasValue :Ind_Remaster ]
) ] rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :reusesSourceCode ; owl:someValuesFrom :Cl_SourceCode ],
    [ a owl:Restriction ; owl:onProperty :updatesContent ; owl:someValuesFrom :Cl_ArtAsset ],
    [ a owl:Restriction ; owl:onProperty :updatesContent ; owl:someValuesFrom :Cl_GameModel ],
    [ a owl:Restriction ; owl:onProperty :updatesContent ; owl:someValuesFrom :Cl_Level ] .

[ a owl:Class ; owl:intersectionOf (
    :Cl_VideoGame
    [ a owl:Restriction ; owl:onProperty :hasVersionForm ; owl:hasValue :Ind_Remake ]
) ] rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :updatesContent ; owl:someValuesFrom :Cl_ArtAsset ] .

:Cl_CoreGame rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :hasPurpose ; owl:hasValue :Ind_Entertainment ] .

:Cl_CasualGame rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :hasDesignCharacteristic ; owl:hasValue :Ind_EaseOfAccessibility ],
    [ a owl:Restriction ; owl:onProperty :hasDesignCharacteristic ; owl:hasValue :Ind_SimpleToUnderstandGameplay ],
    [ a owl:Restriction ; owl:onProperty :hasDesignCharacteristic ; owl:hasValue :Ind_QuickToGraspRuleSets ] .

:Cl_SeriousGame rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :hasPurpose ; owl:hasValue :Ind_NonEntertainmentPurpose ] .

:Cl_ArtGame rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :intendedToGenerate ; owl:hasValue :Ind_Emotion ],
    [ a owl:Restriction ; owl:onProperty :intendedToGenerate ; owl:hasValue :Ind_Empathy ] .

:Cl_CrossRegionRatingAffirmation rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty :basedOnCompletedReview ; owl:someValuesFrom :Cl_ContentRatingReview ],
    [ a owl:Restriction ; owl:onProperty :affirmsRating ; owl:someValuesFrom :Cl_ContentRating ],
    [ a owl:Restriction ; owl:onProperty :affirmedForRegion ; owl:someValuesFrom :Cl_Region ],
    [ a owl:Restriction ; owl:onProperty :facilitatedBy ; owl:hasValue :Ind_IARC ] .

