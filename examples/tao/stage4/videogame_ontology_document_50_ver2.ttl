    rdfs:subClassOf :Cl_GameController ;
    :sourceLocator "Video Game Document.txt, Input device, line 95"@en .

:Cl_RacingWheel a owl:Class ;
    rdfs:label "Racing wheel"@en ;
    rdfs:subClassOf :Cl_SpecializedController ;
    :sourceLocator "Video Game Document.txt, Input device, line 95"@en .

:Cl_LightGun a owl:Class ;
    rdfs:label "Light gun"@en ;
    rdfs:subClassOf :Cl_SpecializedController ;
    :sourceLocator "Video Game Document.txt, Input device, line 95"@en .

