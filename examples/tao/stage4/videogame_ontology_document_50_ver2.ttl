    rdfs:label "Stereoscopic screen"@en ;
    rdfs:subClassOf :Cl_DisplayDevice ;
    :sourceLocator "Video Game Document.txt, Virtual reality, line 77"@en .

:Cl_HandheldGameConsole rdfs:comment "A small, self-contained, portable unit integrating a console, small screen, speakers and controls. Buttons, a joystick or other game controllers are alternatives, not jointly mandatory control types."@en ;
    :qualification "Handheld hardware is usually less powerful than PC or home-console hardware."@en .

:Cl_InputDevice rdfs:comment "Translates human actions into game input. The document mentions controllers, keyboards, mice, touchscreens, motion sensors, cameras and microphones as possible input equipment."@en .

:Cl_SpecializedController :qualification "Racing wheels, light guns and dance pads may be used for certain game genres. No particular controller-to-genre pairing is supplied."@en .

:Cl_DisplayDevice rdfs:comment "A physical device that displays game graphics; it is neither the visual output itself nor an on-screen user interface."@en .

:Cl_ClassificationValue a owl:Class ;
    rdfs:label "Classification value"@en ;
    rdfs:comment "A descriptor used in relational classification, not a game instance."@en ;
    :sourceLocator "videogame_tip_document_50_ver2.md, section 2, classification value registry"@en .

:Cl_PlatformCategory a owl:Class ;
    rdfs:label "Platform category"@en ;
    rdfs:subClassOf :Cl_ClassificationValue .

:Cl_VersionForm a owl:Class ;
    rdfs:label "Version form"@en ;
    rdfs:subClassOf :Cl_ClassificationValue .

:Cl_GameMode a owl:Class ;
    rdfs:label "Game mode"@en ;
    rdfs:subClassOf :Cl_ClassificationValue .

:Cl_VisualOutputForm a owl:Class ;
    rdfs:label "Visual output form"@en ;
    rdfs:subClassOf :Cl_ClassificationValue .

:Cl_PlayArrangement a owl:Class ;
    rdfs:label "Play arrangement"@en ;
    rdfs:subClassOf :Cl_ClassificationValue .

:Cl_GameplayStyle a owl:Class ;
    rdfs:label "Gameplay style"@en ;
    rdfs:subClassOf :Cl_ClassificationValue .

:Cl_GameGenre a owl:Class ;
    rdfs:label "Game genre"@en ;
    rdfs:subClassOf :Cl_ClassificationValue .

:Cl_TopLevelGenre a owl:Class ;
    rdfs:label "Top-level genre"@en ;
    rdfs:subClassOf :Cl_GameGenre ;
    :sourceLocator "Video Game Document.txt, Genre, line 113"@en .

:Cl_CrossGenreType a owl:Class ;
    rdfs:label "Cross-genre type"@en ;
    rdfs:subClassOf :Cl_GameGenre ;
    :qualification "Cross-genre types can fall under multiple top-level genres. Specific action-adventure parents are not asserted."@en ;
    :sourceLocator "Video Game Document.txt, Genre, line 113"@en .

:Cl_GameMode rdfs:comment "A participation classification describing how many players can use a game at the same time. Single-player and multiplayer are the primary categories; zero-player involves very limited interaction, not necessarily no human involvement."@en ;
    :sourceLocator "Video Game Document.txt, Mode, lines 117-119"@en .

:Cl_GameGenre :qualification "Genres are generally based on gameplay interaction rather than narrative setting. Horror is a narrative-based exception. Genre names may change over time; no single-parent hierarchy is imposed."@en ;
    :sourceLocator "Video Game Document.txt, Genre, lines 111-113"@en .

:Cl_VersionForm rdfs:comment "Port, Remaster and Remake are potentially overlapping version-form values, not video-game subclasses."@en ;
    :sourceLocator "videogame_tip_document_50_ver2.md, section 1, VersionForm; Video Game Document.txt, Platform, line 43"@en .

:Cl_GameExtension a owl:Class ;
    rdfs:label "Game extension"@en ;
    rdfs:comment "An addition or modification that extends or changes an existing game."@en ;
    :sourceLocator "videogame_tip_document_50_ver2.md, section 2, game extension registry"@en .

:Cl_ExpansionPack a owl:Class ;
    rdfs:label "Expansion pack"@en ;
    rdfs:subClassOf :Cl_GameExtension ;
    :qualification "Can provide new game content and software patches; typically available as physical media. May be free or used for post-release monetization."@en ;
    :sourceLocator "Video Game Document.txt, Game media, line 91"@en .

:Cl_DownloadableContent a owl:Class ;
    rdfs:label "Downloadable content"@en ;
    rdfs:subClassOf :Cl_GameExtension ;
    :qualification "Can provide new game content and software patches; nominally available through digital distribution. May be free or used for post-release monetization."@en ;
    :sourceLocator "Video Game Document.txt, Game media, line 91"@en .

:Cl_UserCreatedModification a owl:Class ;
    rdfs:label "User-created modification"@en ;
    rdfs:subClassOf :Cl_GameExtension ;
    rdfs:comment "Also called a mod; a player-created alteration or addition to a game."@en ;
    :qualification "Mostly described for personal-computer games. Often unofficial and developed through reverse engineering, but some games officially support modding."@en ;
    :sourceLocator "Video Game Document.txt, Game media, line 91"@en .

:Cl_PhysicalGameMedia a owl:Class ;
    rdfs:label "Physical game media"@en ;
    :qualification "Physical delivery is optional; digital distribution and cloud gaming can remove the need for physical media. Media may be used directly or for installing assets to local storage."@en ;
    :sourceLocator "Video Game Document.txt, Game media, line 89"@en .

:Cl_ROMCartridge a owl:Class ;
    rdfs:label "ROM cartridge"@en ;
    rdfs:subClassOf :Cl_PhysicalGameMedia ;
    :sourceLocator "Video Game Document.txt, Game media, line 89"@en .

:Cl_MagneticStorage a owl:Class ;
    rdfs:label "Magnetic storage"@en ;
    rdfs:subClassOf :Cl_PhysicalGameMedia ;
    :sourceLocator "Video Game Document.txt, Game media, line 89"@en .

:Cl_OpticalMedia a owl:Class ;
    rdfs:label "Optical media"@en ;
    rdfs:subClassOf :Cl_PhysicalGameMedia ;
    :sourceLocator "Video Game Document.txt, Game media, line 89"@en .

